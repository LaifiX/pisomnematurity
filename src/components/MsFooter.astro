---
import { SITE_NAME, SITE_DOMAIN, MATH_SITE_URL, CONTACT_EMAIL, NIVAM_SOURCE_URL } from '../lib/site';
import { testsCatalog, type TestCatalogItem } from '../data/testsCatalog';
import BrandMark from './BrandMark.astro';

interface Props {
  test?: TestCatalogItem;
}

const { test } = Astro.props;
const SJL9_SITE_URL = 'https://monitorsolina.sk';
const readyTests = testsCatalog.filter((t) => t.status === 'ready');
const schoolYearsList = readyTests.map((t) => t.schoolYear);
const schoolYearsText =
  schoolYearsList.length > 1
    ? `${schoolYearsList.slice(0, -1).join(', ')} a\u00A0${schoolYearsList[schoolYearsList.length - 1]}`
    : schoolYearsList[0] || '';
---

    <footer class="ms-footer">
      <div class="ms-wrap">
        <div class="ms-footer-top">
          <a class="ms-brand" href="/">
            <BrandMark size={40} class="ms-mark" />
            <span class="ms-brand-text">
              <strong>{SITE_NAME}</strong>
              <small>{SITE_DOMAIN}</small>
            </span>
          </a>
          <nav class="ms-footer-links" aria-label="Odkazy v pätičke">
            <a href="/#testy">Testy</a>
            <a href="/sloh/">Slohové útvary</a>
            <a href={SJL9_SITE_URL} target="_blank" rel="noopener noreferrer">Testovanie 9 zo slovenčiny</a>
            <a href={MATH_SITE_URL} target="_blank" rel="noopener noreferrer">Testovanie 9 z&nbsp;matematiky</a>
            <a href={`mailto:${CONTACT_EMAIL}`}>Kontakt</a>
          </nav>
        </div>
        <div class="ms-footer-legal" aria-label="Autorské práva a podmienky sprístupnenia testov NIVaM">
          <p>
            {test ? (
              <Fragment>
                <strong>
                  Nositeľ autorských práv k&nbsp;úlohám a&nbsp;ku kľúču správnych odpovedí (Externá časť maturitnej skúšky&nbsp;{test.year}, šk.&nbsp;rok {test.schoolYear}, {test.variant.charAt(0).toLowerCase() + test.variant.slice(1)}, kód&nbsp;{test.code}): Národný inštitút vzdelávania a&nbsp;mládeže (NIVaM).
                </strong>{' '}
              </Fragment>
            ) : (
              <Fragment>
                <strong>Nositeľ autorských práv k&nbsp;testom a&nbsp;kľúčom odpovedí:</strong> Nositeľom autorských práv k&nbsp;zverejneným testom a&nbsp;úlohám riadneho termínu <strong>externej časti maturitnej skúšky (EČ&nbsp;MS)</strong> zo slovenského jazyka a&nbsp;literatúry (školské roky {schoolYearsText}) a&nbsp;ku kľúčom správnych odpovedí k&nbsp;nim je <strong>Národný inštitút vzdelávania a&nbsp;mládeže (NIVaM)</strong>.{' '}
              </Fragment>
            )}
            Zdrojové dokumenty sú verejne prístupné na portáli <a href={NIVAM_SOURCE_URL} target="_blank" rel="noopener noreferrer">www2.nucem.sk (Maturita – Dokumenty na stiahnutie)</a>. Tieto testy EČ&nbsp;MS sú sprístupnené so súhlasom NIVaM a&nbsp;prístup k&nbsp;nim je voľný a&nbsp;bezplatný.
          </p>
          <p>
            <strong>Prepis úloh a&nbsp;autorské vzorové riešenia:</strong> Texty ukážok, úloh a&nbsp;grafické objekty (tabuľky, schémy, obrázky) boli pre potreby interaktívneho online zobrazenia prepisované a&nbsp;graficky upravované – <strong>NIVaM nezodpovedá za prípadné chyby vzniknuté z&nbsp;tohto dôvodu</strong>. Vytvárané a&nbsp;zverejnené <strong>vzorové riešenia (postupy riešenia a&nbsp;nápovedy) a&nbsp;študijné materiály k&nbsp;slohovým útvarom nie sú autorským dielom NIVaM a&nbsp;NIVaM nezodpovedá za ich obsah</strong>.
          </p>
        </div>
        <p class="ms-footer-copy">© {new Date().getFullYear()} {SITE_DOMAIN} · Peter Beňo</p>
      </div>
    </footer>

<script is:inline>
  // Slovenská typografia na celom webe: pevná medzera po jednopísmenových predložkách a spojkách (k, s, v, z, a, i, o, u)
  // a medzi číslom a slovom (64 úloh, 100 minút, 3,1 %). V teste to robí aj jeho vlastný skript pri každej úlohe.
  (function () {
    var root = document.querySelector('main');
    if (!root || typeof NodeFilter === 'undefined') return;
    var SKIP = { SCRIPT: 1, STYLE: 1, CODE: 1, PRE: 1, INPUT: 1, TEXTAREA: 1, BUTTON: 0 };
    var PREP = /(^|[\s\u00A0„(\[–])([ksvzauoiKSVZAUOI])[ \t\r\n]+(?=\S)/g;
    var NUM = /(\d)[ \t\r\n]+(?=[A-Za-zÀ-žĽľŠšČčŤťŽžÝýÁáÍíÉéÚúÄäÔôŇňĎďĹĺŔŕÓó%])/g;
    // Číselný rozsah (2022 – 2026, 1,5 – 3): pevné medzery a za pomlčkou spojovník slov (U+2060),
    // inak prehliadač smie zalomiť riadok hneď za pomlčkou aj pred pevnou medzerou
    var RANGE = /(\d)[  ]–[  ](?=\d)/g;
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode: function (node) {
        for (var el = node.parentElement; el && el !== root; el = el.parentElement) {
          if (SKIP[el.tagName]) return NodeFilter.FILTER_REJECT;
        }
        return /\s/.test(node.nodeValue || '') ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
      }
    });
    var nodes = [];
    var n;
    while ((n = walker.nextNode())) nodes.push(n);
    nodes.forEach(function (node) {
      var t = node.nodeValue;
      var u = t.replace(PREP, '$1$2\u00A0').replace(PREP, '$1$2\u00A0').replace(NUM, '$1\u00A0').replace(RANGE, '$1\u00A0\u2013\u2060\u00A0');
      if (u !== t) node.nodeValue = u;
    });
  })();
</script>
