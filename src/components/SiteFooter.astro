---
// Shared footer with the NIVaM copyright block, worded the same way as on monitormatika.sk
// (attribution, source documents on nucem.sk, transcription disclaimer, solutions are not NIVaM's work).
import { testsCatalog, type TestCatalogItem } from '../data/testsCatalog';
import { MATH_SITE_URL, CONTACT_EMAIL, NIVAM_SOURCE_URL } from '../lib/site';
import { I, icon } from '../lib/icons';

interface Props {
  test?: TestCatalogItem;
}

const { test } = Astro.props;
const readyTests = testsCatalog.filter((t) => t.status === 'ready');
const schoolYears = readyTests.map((t) => t.schoolYear).join(', ');
const schoolYearsLabel = readyTests.length > 1 ? 'školské roky' : 'školský rok';
---

<footer class="site-legal-footer">
  <div class="site-legal-inner">
    <div class="site-legal-top">
      <div>
        <a class="site-legal-brand" href="/">
          <span class="brand-mark" aria-hidden="true">T9</span>
          <span>
            <strong>Testovanie 9</strong>
            <small>Online príprava zo slovenčiny</small>
          </span>
        </a>
        <p class="site-legal-about">
          Bezplatná pomôcka pre žiakov 9.&nbsp;ročníka ZŠ, rodičov a&nbsp;učiteľov na tréning úloh z&nbsp;Testovania&nbsp;9 zo slovenského jazyka a&nbsp;literatúry.
        </p>
      </div>
      <nav class="site-legal-links" aria-label="Odkazy v pätičke">
        {readyTests.map((t) => <a href={`/test/${t.slug}/`}>{t.title}</a>)}
        <button type="button" data-share>
          <Fragment set:html={icon(I.share)} /> <span data-share-label>Zdieľať stránku</span>
        </button>
        <a href={MATH_SITE_URL} target="_blank" rel="noopener noreferrer">
          Monitor z matematiky <Fragment set:html={icon(I.external)} />
        </a>
        <a href={`mailto:${CONTACT_EMAIL}`}>
          <Fragment set:html={icon(I.mail)} /> Kontakt
        </a>
      </nav>
    </div>

    <section aria-label="Autorské práva a podmienky sprístupnenia testov NIVaM">
      <div class="site-nivam-head">
        <span class="site-nivam-badge">©&nbsp;NIVaM</span>
        <strong>Autorské práva a&nbsp;podmienky sprístupnenia testov Testovania&nbsp;9</strong>
      </div>
      <div class="site-nivam-grid">
        <p>
          {test ? (
            <Fragment>
              <strong>
                Nositeľ autorských práv k&nbsp;úlohám a&nbsp;kľúču správnych odpovedí ({test.title}, šk.&nbsp;rok {test.schoolYear}, {test.variant.replace(/^V/, 'v')}, kód&nbsp;{test.code}): Národný inštitút vzdelávania a&nbsp;mládeže (NIVaM).
              </strong>{' '}
            </Fragment>
          ) : (
            <Fragment>
              <strong>Nositeľ autorských práv k&nbsp;testom a&nbsp;kľúčom odpovedí:</strong> Nositeľom autorských práv k&nbsp;zverejneným testom/úlohám riadneho termínu <strong>Testovania&nbsp;9</strong> zo slovenského jazyka a&nbsp;literatúry ({`${schoolYearsLabel} ${schoolYears}`}) a&nbsp;ku&nbsp;kľúčom správnych odpovedí k&nbsp;nim je <strong>Národný inštitút vzdelávania a&nbsp;mládeže (NIVaM)</strong>.{' '}
            </Fragment>
          )}
          Zdrojové dokumenty sú verejne prístupné na&nbsp;portáli{' '}
          <a href={NIVAM_SOURCE_URL} target="_blank" rel="noopener noreferrer">www2.nucem.sk (Testovanie&nbsp;9&nbsp;– Dokumenty na&nbsp;stiahnutie)</a>. Testy sú sprístupnené so&nbsp;súhlasom NIVaM a&nbsp;prístup k&nbsp;nim je voľný a&nbsp;bezplatný.
        </p>
        <p>
          <strong>Prepis úloh a&nbsp;autorské vzorové riešenia:</strong> Texty ukážok, úloh a&nbsp;grafické objekty (grafy, ilustrácie, tabuľky) boli pre&nbsp;potreby interaktívneho online zobrazenia prepisované a&nbsp;graficky upravované&nbsp;– <strong>NIVaM nezodpovedá za&nbsp;prípadné chyby vzniknuté z&nbsp;tohto dôvodu</strong>. Vytvárané a&nbsp;zverejnené <strong>postupy riešenia a&nbsp;nápovedy nie&nbsp;sú autorským dielom NIVaM a&nbsp;NIVaM nezodpovedá za&nbsp;ich obsah</strong>.
        </p>
      </div>
    </section>

    <p class="site-legal-copy">© {new Date().getFullYear()} Testovanie 9 · Online príprava zo slovenčiny · Peter Beňo so synom Nikolajom</p>
  </div>
</footer>
