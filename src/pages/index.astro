---
import '../styles/fonts.css';
import '../styles/ms.css';
import SeoHead from '../components/SeoHead.astro';
import { ALLOW_INDEXING } from '../lib/site';
import MsHeader from '../components/MsHeader.astro';
import MsFooter from '../components/MsFooter.astro';
import BrandMark from '../components/BrandMark.astro';
import { maturitaCatalog } from '../data/maturitaCatalog';
import { slohoveUtvary, temy, PROJEKT } from '../data/sloh';
import { testsDataBySlug } from '../data/tests';
// Ukážková úloha pre sekciu „Ako to funguje“ – skutočná úloha 02 z Maturity 2023 (text, nápoveda, postup z dát testu)
const demoQ = testsDataBySlug['ms-2023'].questions.find((q) => q.code === '02')!;
// Autori ukážok pre kartu ročníka (len mená autorov, bez názvov vecných textov a zakrytých autorov)
const TEST_AUTHORS: Record<string, string[]> = {
  'ms-2026': ['Poe', 'Dilong', 'Beňová', 'Jesenský', 'Tolstoj'],
  'ms-2025': ['Kerouac', 'Štrasser', 'Coelho', 'Lasica', 'Satinský', 'Rolland'],
  'ms-2024': ['Kováč', 'Eco', 'Bukovčan', 'Lehenová', 'Vocelka', 'Goethe'],
  'ms-2023': ['Hevier', 'Rimbaud', 'Kukučín', 'Pupala', 'Shakespeare', 'Jilemnický'],
  'ms-2022': ['Puškin', 'Marčok', 'Kesey', 'Taragel', 'Bednár', 'Molière', 'Pišťanek']
};
const passageNames = (slug: string) => TEST_AUTHORS[slug] ?? [];
const plainMarks = (t: string) => t.replace(/\/\/(.+?)\/\//g, '<em>$1</em>');
const slohCount = (slug: string) => temy.filter((t) => t.slug === slug).length;
const slohMax = Math.max(...slohoveUtvary.map((u) => slohCount(u.slug)));
import { MATH_SITE_URL, CONTACT_EMAIL, SITE_URL, SITE_NAME } from '../lib/site';
import { I, icon } from '../lib/icons';

const SJL9_SITE_URL = 'https://monitorsolina.sk';
const tests = maturitaCatalog;
const ready = tests.filter((t) => t.status === 'ready');
const first = ready[0] ?? tests[0];
const years = tests.map((t) => t.year);
const yearsRange = `${Math.min(...years)} – ${Math.max(...years)}`;

const author = { '@type': 'Person', name: 'Mgr. Peter Beňo', jobTitle: 'Bývalý učiteľ slovenského jazyka a literatúry' };
// faqs je definované nižšie – JSON-LD sa skladá až po ňom (homeJsonLd)
// Rozsah rokov do viditeľného textu: po pomlčke je spojovník slov (U+2060) – prehliadač smie zalomiť riadok
// aj medzi pomlčkou a pevnou medzerou, a vtedy vzniklo „2022 –“ / „ 2026“
const yearsRangeText = `${Math.min(...years)} –⁠ ${Math.max(...years)}`;
const faqs = [
  {
    q: 'Ako vyzerá test externej časti maturity zo slovenčiny?',
    a: 'Test má 64 úloh – 40 s výberom zo štyroch možností a 24 s krátkou odpoveďou. Úlohy sa viažu na 8 ukážok: päť umeleckých textov, dva publicistické (alebo publicistický a administratívny) a jeden náučný text. Na riešenie máš 100 minút a za každú správnu odpoveď získaš 1 bod.'
  },
  {
    q: 'Môžem na maturite používať pravidlá alebo slovník?',
    a: 'Pri teste externej časti nie – nesmieš používať slovníky, učebnice ani inú literatúru. Pri písomnej forme internej časti (sloh) môžeš mať Pravidlá slovenského pravopisu, Synonymický slovník a Krátky slovník slovenského jazyka.'
  },
  {
    q: 'Ako prebieha písomná forma internej časti (sloh)?',
    a: 'Zo štyroch zadaných tém si vyberieš jednu. Každá téma určuje slohový útvar – napríklad úvahu, rozprávanie alebo diskusný príspevok. Máš 150 minút a rozsah práce je 1,5 až 3 strany. V časti Slohové útvary nájdeš ku každému útvaru, čo musí obsahovať a ako ho postaviť.'
  },
  {
    q: 'Ako sa líši ostrý test od precvičovania?',
    a: 'Ostrý test beží na čas ako na skutočnej maturite a vyhodnotíš ho naraz na konci. Pri precvičovaní si každú úlohu overíš hneď a môžeš si otvoriť nápovedu aj postup riešenia.'
  },
  {
    q: 'Je príprava zadarmo a odkiaľ sú úlohy?',
    a: 'Všetko je zadarmo, bez registrácie a bez reklám. Úlohy a kľúče správnych odpovedí pochádzajú z oficiálnych testov externej časti maturitnej skúšky, ktorých autorom je Národný inštitút vzdelávania a mládeže (NIVaM). Nápovedy a postupy riešenia pripravuje učiteľ slovenčiny.'
  }
];

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      alternateName: 'pisomnematurity.sk',
      description: 'Bezplatná príprava na maturitu zo slovenského jazyka a literatúry: oficiálne testy externej časti s nápovedou a postupom riešenia a slohové útvary.',
      inLanguage: 'sk',
      author,
      publisher: author
    },
    {
      '@type': 'ItemList',
      name: 'Testy externej časti maturity zo slovenčiny',
      itemListElement: tests
        .filter((t) => t.status === 'ready')
        .map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: `Maturita ${t.year}`, url: `${SITE_URL}/test/${t.slug}/` }))
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
    }
  ]
};
---

<!DOCTYPE html>
<html lang="sk">
  <head>
    <SeoHead
      title={`Písomné maturity – maturita zo SJL: testy ${yearsRange} a sloh`}
      description={`Bezplatná príprava na maturitu zo slovenčiny: oficiálne testy externej časti ${yearsRange} s nápovedou a postupom riešenia a všetky slohové útvary.`}
      path="/"
      themeColor="#1e2a5e"
      ogTitle="Písomné maturity – maturita zo slovenčiny na skutočných testoch"
      jsonLd={homeJsonLd}
      noindex={!ALLOW_INDEXING}
    />
  </head>
  <body class="ms">
    <a class="skip-link" href="#obsah">Preskočiť na hlavný obsah</a>

    <MsHeader />

    <main id="obsah">
      <section class="ms-hero">
        <div class="ms-wrap">
          <div class="ms-hero-grid">
            <div>
              <h1 class="ms-h1">Maturita zo slovenčiny <em>na skutočných testoch</em></h1>
              <p class="ms-lead">
                Rieš oficiálne testy externej časti z&nbsp;rokov {yearsRangeText} presne tak, ako na maturite – s&nbsp;ukážkou vedľa úloh a&nbsp;časom 100&nbsp;minút.
                Pri každej úlohe máš nápovedu a&nbsp;postup riešenia, ktorý pripravil učiteľ slovenčiny. A&nbsp;k&nbsp;slohu prehľad všetkých maturitných útvarov.
              </p>
              <div class="ms-ctas">
                <a class="ms-btn ms-btn-primary" href="#testy">
                  Vybrať test
                  <Fragment set:html={icon(I.arrow)} />
                </a>
                <a class="ms-btn ms-btn-ghost" href="#sloh">
                  <Fragment set:html={icon(I.feather)} />
                  Slohové útvary
                </a>
              </div>
              <div class="ms-hero-tools">
                <button class="ms-tool-btn" type="button" data-install="any" title="Pridať stránku na plochu ako aplikáciu">
                  <Fragment set:html={icon(I.appAdd)} />
                  <span>Pridať na plochu</span>
                </button>
                <button class="ms-tool-btn" type="button" data-share title="Zdieľať odkaz na stránku">
                  <Fragment set:html={icon(I.share)} />
                  <span data-share-label>Zdieľať</span>
                </button>
              </div>
              <ul class="ms-meta">
                <li><Fragment set:html={icon(I.user)} />Bez registrácie</li>
                <li><Fragment set:html={icon(I.phone)} />Na počítači aj v&nbsp;mobile</li>
                <li><Fragment set:html={icon(I.heart)} />Zadarmo, bez reklám</li>
                <li class:list={['ms-visits', { hidden: !import.meta.env.DEV, 'is-preview': import.meta.env.DEV }]} id="visitsBox" data-dev={import.meta.env.DEV ? '1' : undefined}><Fragment set:html={icon(I.eye)} /><span><strong id="visitsCount">{import.meta.env.DEV ? 'Počítadlo návštev' : '0'}</strong> <span id="visitsLabel">{import.meta.env.DEV ? '– číslo sa zobrazí na pisomnematurity.sk' : 'návštev'}</span></span></li>
              </ul>
            </div>

            <div class="ms-sheet-wrap">
            <figure class="ms-sheet" aria-label="Ilustračná ukážka úlohy">
              <div class="ms-sheet-top">
                <span class="ms-sheet-tag">Ukážka 6 · náučný text</span>
                <span>Úloha 43 / 64</span>
              </div>
              <p class="ms-sheet-text">
                Jazyk sa neustále mení. S&nbsp;novými vecami prichádzajú nové slová, iné postupne zastarávajú a&nbsp;z&nbsp;bežnej reči miznú. Príčinou nie je náhoda, ale potreby ľudí, ktorí jazyk používajú.
              </p>
              <p class="ms-sheet-q">Ktorý slohový postup v&nbsp;ukážke prevláda?</p>
              <ol class="ms-sheet-opts">
                <li><b>A</b>opisný</li>
                <li><b>B</b>rozprávací</li>
                <li class="is-ok"><b>C</b>výkladový</li>
                <li><b>D</b>informačný</li>
              </ol>
              <p class="ms-sheet-hint"><Fragment set:html={icon(I.bulb)} /><span><b>Nápoveda:</b> Text vysvetľuje, prečo sa jazyk mení. Ktorý postup odpovedá na otázku „prečo“?</span></p>
            </figure>
            </div>
          </div>

          <dl class="ms-facts">
            <div><dt>64 úloh</dt><dd>40 s&nbsp;výberom odpovede, 24 s&nbsp;krátkou odpoveďou</dd></div>
            <div><dt>100 minút</dt><dd>časový limit ako na maturite</dd></div>
            <div><dt>8 ukážok</dt><dd>umelecké, publicistické aj náučné texty</dd></div>
            <div><dt>{tests.length} ročníkov</dt><dd>riadne termíny {yearsRangeText}</dd></div>
          </dl>
        </div>
      </section>

      <section class="ms-sec ms-sec-alt" id="testy">
        <div class="ms-wrap">
          <div class="ms-sec-head">
            <div>
              <span class="ms-kicker">Externá časť</span>
              <h2>Testy z&nbsp;minulých rokov</h2>
              <p>Oficiálne testy NIVaM z&nbsp;riadnych termínov. Rozpracovaný test sa ti priebežne ukladá, takže môžeš kedykoľvek pokračovať.</p>
            </div>
          </div>
          <div class="ms-tests">
            {tests.map((t) =>
              t.status === 'ready' ? (
                <a class="ms-test" href={`/test/${t.slug}/`} data-test-card={t.slug} data-total={t.questionsCount}>
                  <span class="ms-test-term">Riadny termín {t.schoolYear}</span>
                  <span class="ms-test-year">{t.year}</span>
                  <ul class="ms-test-specs">
                    <li>{t.questionsCount}&nbsp;úloh · {t.durationMinutes}&nbsp;minút</li>
                    <li>©&nbsp;NIVaM</li>
                  </ul>
                  {passageNames(t.slug).length > 0 && (
                    <p class="ms-test-authors"><span class="ms-sr">Autori v teste: </span>{passageNames(t.slug).join(', ')}</p>
                  )}
                  <div class="ms-saved hidden" data-saved-slot></div>
                  <div class="ms-test-foot">
                    <span class="ms-dot" data-cta>Spustiť test</span>
                    <Fragment set:html={icon(I.arrow)} />
                  </div>
                </a>
              ) : (
                <article class="ms-test">
                  <span class="ms-test-term">Riadny termín {t.schoolYear}</span>
                  <span class="ms-test-year">{t.year}</span>
                  <ul class="ms-test-specs">
                    <li>{t.questionsCount}&nbsp;úloh · {t.durationMinutes}&nbsp;minút</li>
                    <li>{t.passagesCount}&nbsp;ukážok · ©&nbsp;NIVaM</li>
                  </ul>
                  <div class="ms-test-foot">
                    <span class="ms-dot">Pripravujeme</span>
                    <Fragment set:html={icon(I.hourglass)} />
                  </div>
                </article>
              )
            )}
          </div>
        </div>
      </section>

      <section class="ms-sec ms-sloh" id="sloh">
        <div class="ms-wrap">
          <div class="ms-sec-head">
            <div>
              <span class="ms-kicker">Písomná forma internej časti</span>
              <h2>Slohové útvary na maturite</h2>
              <p>Zo štyroch tém si vyberieš jednu a&nbsp;každá určuje slohový útvar. Ku každému nájdeš znaky, kompozíciu, jazykové prostriedky, časté chyby a&nbsp;kontrolný zoznam pred odovzdaním.</p>
              <div class="ms-sloh-rules">
                <span>150 minút</span>
                <span>1 zo 4 tém</span>
                <span>1,5 – 3 strany</span>
                <span>Pravidlá a&nbsp;slovníky povolené</span>
              </div>
            </div>
          </div>
          <ol class="ms-sloh-list">
            {slohoveUtvary.map((u) => (
              <li>
                <a href={`/sloh/${u.slug}/`}>
                  <span class="ms-sl-line">
                    <span class="ms-sl-name">{u.name}</span>
                    <span class="ms-sl-lead" aria-hidden="true"></span>
                    <span class="ms-sl-count">{slohCount(u.slug)}×<span class="ms-sr"> na maturite</span></span>
                  </span>
                  <span class="ms-sl-desc" set:html={u.short} />
                  <span class="ms-sl-bar" aria-hidden="true"><span style={`width:${Math.round((slohCount(u.slug) / slohMax) * 100)}%`}></span></span>
                </a>
              </li>
            ))}
          </ol>
          <div class="ms-sloh-foot">
            <a class="ms-btn ms-btn-ghost" href="/sloh/#prehlad">
              Prehľad tém 2007 – 2026
              <Fragment set:html={icon(I.arrow)} />
            </a>
            <p class="ms-sloh-origin">
              Vychádza z&nbsp;učebných materiálov <a href="/sloh/#povod">{PROJEKT.series}</a>, ktoré vznikli v&nbsp;projekte EÚ {PROJEKT.name} ({PROJEKT.year}).
            </p>
          </div>
        </div>
      </section>

      <section class="ms-sec" id="ako-to-funguje">
        <div class="ms-wrap">
          <div class="ms-sec-head">
            <div>
              <span class="ms-kicker">Ako to funguje</span>
              <h2>Jedna úloha od otázky po vysvetlenie</h2>
              <p>Takto vyzerá práca s&nbsp;testom. Úloha, nápoveda aj postup riešenia sú skutočné, z&nbsp;Maturity 2023.</p>
            </div>
          </div>
          <div class="ms-how">
            <figure class="ms-how-task" aria-label={`Ukážková úloha ${demoQ.code} z Maturity 2023`}>
              <div class="ms-how-task-top">
                <span class="ms-how-num">Úloha {demoQ.code}</span>
                <span class="ms-how-src">Maturita 2023 · ukážka 1 (D. Hevier)</span>
              </div>
              <p class="ms-how-q" set:html={plainMarks(demoQ.questionText)} />
              <ol class="ms-how-opts">
                {demoQ.options!.map((o) => (
                  <li class={o.key === demoQ.correctAnswerDisplay ? 'is-ok' : undefined}><b>{o.key}</b>{o.text}</li>
                ))}
              </ol>
              <div class="ms-how-check"><Fragment set:html={icon(I.checkCircle)} />Výborne, správne! Odpoveď {demoQ.correctAnswerDisplay} je správna.</div>
            </figure>

            <ol class="ms-how-steps">
              <li>
                <h3>Odpovieš s&nbsp;ukážkou vedľa úlohy</h3>
                <p>Text, ku ktorému sa úlohy viažu, máš stále na očiach. Netreba listovať.</p>
              </li>
              <li>
                <h3>Hneď si overíš, či máš pravdu</h3>
                <p>Pri precvičovaní stačí ťuknúť na Overiť odpoveď. Upozorní ťa aj na chýbajúcu diakritiku či veľké písmeno.</p>
              </li>
              <li>
                <h3>Keď nevieš, pomôže nápoveda</h3>
                <blockquote class="ms-how-hint"><Fragment set:html={icon(I.bulb)} /><span set:html={plainMarks(demoQ.hint!)} /></blockquote>
              </li>
              <li>
                <h3>Postup riešenia vysvetlí prečo</h3>
                <blockquote class="ms-how-sol"><strong>{demoQ.solutionSteps![0].title}</strong><span set:html={plainMarks(demoQ.solutionSteps![0].text)} /></blockquote>
              </li>
              <li>
                <h3>Na konci vieš, čo zopakovať</h3>
                <p>Ostrý test beží 100&nbsp;minút bez pomôcok. Po vyhodnotení uvidíš úspešnosť v&nbsp;čítaní s&nbsp;porozumením, literatúre, pravopise a&nbsp;skladbe.</p>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <section class="ms-sec ms-sec-alt" id="otazky">
        <div class="ms-wrap ms-faq">
          <div>
            <span class="ms-kicker">Otázky</span>
            <h2 style="font-size: clamp(2rem, 3.6vw, 2.8rem)">Čo potrebuješ vedieť o&nbsp;maturite</h2>
          </div>
          <div>
            {faqs.map((f) => (
              <details class="ms-faq-item">
                <summary>
                  <span>{f.q}</span>
                  <Fragment set:html={icon(I.chevron)} />
                </summary>
                <div class="ms-faq-body">
                  <div class="ms-faq-body-in">
                    <p>{f.a}</p>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="ms-sec" id="autor" aria-labelledby="ms-autor-name">
        <div class="ms-wrap">
          <div class="ms-about-sheet">
            <div class="ms-about-top">
              <article class="ms-guarantor">
                <span class="ms-guarantor-photo">
                  <img src="/images/peter2.webp" alt="Peter Beňo" width="900" height="900" loading="lazy" decoding="async" />
                </span>
                <div class="ms-guarantor-body">
                  <h3 id="ms-autor-name">Peter Beňo</h3>
                  <div class="ms-roles">
                    <span class="ms-role">Bývalý učiteľ strednej školy</span>
                    <span class="ms-role is-guarantor"><Fragment set:html={icon(I.checkCircle)} />Garant riešení</span>
                  </div>
                  <p>
                    Ako bývalý stredoškolský učiteľ ručí za&nbsp;správnosť výsledkov, nápovied aj&nbsp;postupov. Dbá na&nbsp;to, aby boli vysvetlenia zrozumiteľné a&nbsp;pomohli žiakovi učivo naozaj pochopiť. V&nbsp;praxi bol známy tým, že dokázal vydolovať maximum aj&nbsp;z&nbsp;tých najlenivejších žiakov.
                  </p>
                </div>
              </article>

              <aside class="ms-heart" id="feedbackHeartCard" aria-live="polite">
                <div class="ms-heart-txt">
                  <h3 id="feedbackHeartTitle">Pomáha ti táto stránka?</h3>
                  <p id="feedbackHeartDesc">
                    Prináša ti táto stránka hodnotu? Daj nám vedieť srdiečkom alebo ju pošli spolužiakom.
                  </p>
                </div>
                <div class="ms-heart-actions">
                  <button
                    type="button"
                    class="ms-heart-btn"
                    id="heartLikeBtn"
                    aria-pressed="false"
                    title="Podporiť stránku kliknutím na srdiečko"
                  >
                    <span class="ms-heart-icon"><Fragment set:html={icon(I.heart)} /></span>
                    <span id="heartBtnLabel">Páči sa&nbsp;mi&nbsp;to</span>
                    <span class="ms-heart-count" id="heartCountValue">0</span>
                  </button>
                  <button
                    type="button"
                    class="ms-btn ms-btn-ghost ms-heart-share"
                    data-share
                    title="Poslať odkaz na stránku spolužiakom"
                  >
                    <Fragment set:html={icon(I.share)} />
                    <span data-share-label>Zdieľať</span>
                  </button>
                </div>
              </aside>
            </div>

            <aside class="ms-volunteer" id="podpora" aria-labelledby="ms-volunteer-title">
              <span class="ms-volunteer-ico" aria-hidden="true"><Fragment set:html={icon(I.heart)} /></span>

              <div class="ms-volunteer-main">
                <div class="ms-volunteer-txt">
                  <span class="ms-volunteer-kicker">Podpor stránku</span>
                  <h3 id="ms-volunteer-title">Stránku tvoríme dobrovoľne, vo&nbsp;voľnom čase</h3>
                  <p>
                    Táto stránka je bezplatná. Ak ti priniesla hodnotu a&nbsp;pomohla ti, môžeš sa&nbsp;rozhodnúť ju podporiť dobrovoľným príspevkom, ktorý bude použitý <strong>výlučne len na&nbsp;prenájom domény pre&nbsp;ďalšie roky</strong>, aby mohla byť k&nbsp;dispozícii aj pre&nbsp;tvojich mladších spolužiakov.
                  </p>
                </div>

                <div class="ms-pay-bar">
                  <div class="ms-pay-info">
                    <code class="ms-pay-iban">SK97 1100 0000 0029 3029 3777</code>
                    <span class="ms-pay-sub">Príjemca: <strong>Beňo Peter, Mgr</strong> · Správa: <strong>Dar - pisomnematurity.sk</strong></span>
                  </div>
                  <button
                    type="button"
                    class="ms-btn ms-btn-ghost ms-btn-sm ms-pay-copy"
                    id="copyIbanBtn"
                    data-iban="SK9711000000002930293777"
                  >
                    <Fragment set:html={icon(I.copy)} />
                    <span id="copyIbanLabel">Skopírovať IBAN</span>
                  </button>
                </div>

                <p class="ms-volunteer-legal">
                  Dobrovoľný dar je bezodplatný, bez protihodnoty a&nbsp;bez vplyvu na&nbsp;voľný prístup k&nbsp;testom a&nbsp;slohovým útvarom.
                  <button type="button" class="ms-legal-link" id="openLegalBtn">Podmienky darovania a&nbsp;ochrana osobných údajov (GDPR)</button>
                </p>
              </div>

