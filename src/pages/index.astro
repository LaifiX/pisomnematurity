    <script is:inline src="/pwa.js"></script>
    <script is:inline>
      // Návštevnosť a srdiečka (Netlify funkcia /api/stats): návšteva sa zapíše raz za reláciu prehliadača,
      // srdiečko najviac raz z daného prehliadača. Každá odpoveď vracia { visits, likes }.
      (function () {
        var SESSION_KEY = 'maturitasjl_visited_session';
        var LIKED_KEY = 'maturitasjl_site_liked';
        var CACHED_LIKES_KEY = 'maturitasjl_cached_likes';

        var box = document.getElementById('visitsBox');
        var heartCard = document.getElementById('feedbackHeartCard');
        var heartBtn = document.getElementById('heartLikeBtn');
        var heartLabel = document.getElementById('heartBtnLabel');
        var heartCount = document.getElementById('heartCountValue');
        var heartTitle = document.getElementById('feedbackHeartTitle');
        var heartDesc = document.getElementById('feedbackHeartDesc');

        function safeGet(k) {
          try { return localStorage.getItem(k); } catch (e) { return null; }
        }
        function safeSet(k, v) {
          try { localStorage.setItem(k, v); } catch (e) {}
        }
        function fmt(n) {
          return Number(n || 0).toLocaleString('sk-SK');
        }
        function showLikes(n) {
          if (heartCount) heartCount.textContent = fmt(n);
        }
        function applyLikedUI(countVal) {
          if (heartCard) heartCard.classList.add('is-liked');
          if (heartBtn) {
            heartBtn.classList.add('is-liked');
            heartBtn.setAttribute('aria-pressed', 'true');
            heartBtn.disabled = true;
          }
          if (heartLabel) heartLabel.textContent = 'Ďakujeme!';
          if (heartTitle) heartTitle.textContent = 'Ďakujeme za podporu!';
          if (heartDesc) heartDesc.textContent = 'Tvoj hlas sme započítali.';
          if (countVal !== undefined) showLikes(countVal);
        }

        var alreadyLiked = safeGet(LIKED_KEY) === '1';
        var cachedLikes = safeGet(CACHED_LIKES_KEY);
        if (cachedLikes !== null) showLikes(cachedLikes);
        else showLikes(alreadyLiked ? 1 : 0);
        if (alreadyLiked) applyLikedUI(cachedLikes !== null ? Number(cachedLikes) : undefined);

        if (heartBtn) {
          heartBtn.addEventListener('click', function () {
            if (safeGet(LIKED_KEY) === '1') return;
            safeSet(LIKED_KEY, '1');
            var cur = parseInt((heartCount && heartCount.textContent || '0').replace(/\s+/g, ''), 10) || 0;
            var next = cur + 1;
            safeSet(CACHED_LIKES_KEY, String(next));
            heartBtn.classList.add('just-clicked');
            applyLikedUI(next);
            if (typeof fetch !== 'function') return;
            fetch('/api/stats', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ like: true })
            })
              .then(function (r) { return r.ok ? r.json() : null; })
              .then(function (d) {
                if (d && typeof d.likes === 'number') {
                  safeSet(CACHED_LIKES_KEY, String(d.likes));
                  showLikes(d.likes);
                }
              })
              .catch(function () {});
          });
        }

        if (typeof fetch !== 'function') return;
        var first = true;
        try { first = !sessionStorage.getItem(SESSION_KEY); } catch (e) {}
        fetch('/api/stats', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(first ? { visit: true } : {})
        })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (!d) return;
            if (typeof d.likes === 'number') {
              safeSet(CACHED_LIKES_KEY, String(d.likes));
              showLikes(d.likes);
            }
            if (box && typeof d.visits === 'number') {
              box.classList.remove('is-preview');
              try { sessionStorage.setItem(SESSION_KEY, '1'); } catch (e) {}
              var n = d.visits;
              document.getElementById('visitsCount').textContent = fmt(n);
              document.getElementById('visitsLabel').textContent = n === 1 ? 'návšteva' : n >= 2 && n <= 4 ? 'návštevy' : 'návštev';
              box.classList.remove('hidden');
            }
          })
          .catch(function () {});
      })();
    </script>
    <script is:inline>
      // Stav testov na kartách ročníkov (len z tohto prehliadača): rozpracovaný, vyhodnotený, posledný výsledok
      (function () {
        const read = (k) => {
          try {
            return JSON.parse(localStorage.getItem(k) || 'null');
          } catch (e) {
            return null;
          }
        };
        const pct = (a, b) => Math.max(0, Math.min(100, Math.round((a / b) * 100)));
        document.querySelectorAll('[data-test-card]').forEach((card) => {
          const slug = card.getAttribute('data-test-card');
          const total = Number(card.getAttribute('data-total')) || 64;
          const slot = card.querySelector('[data-saved-slot]');
          const cta = card.querySelector('[data-cta]');
          const st = read('maturitasjl_test_' + slug + '_v1');
          const snap = read('maturitasjl_result_' + slug + '_v1');
          const last = read('maturitasjl_last_' + slug + '_v1');
          const best = snap && typeof snap.correct === 'number' ? snap : last && typeof last.correct === 'number' ? last : null;
          const bestTotal = best ? best.total || total : total;
          const score = best ? `${best.correct}/${bestTotal} · ${pct(best.correct, bestTotal)} %` : '';
          const answered = st && st.userAnswers ? Object.keys(st.userAnswers).filter((k) => String(st.userAnswers[k]).trim() !== '').length : 0;
          const bar = (w) => `<span class="ms-saved-track"><span style="width:${w}%"></span></span>`;
          const show = (cls, label, value, w, extra) => {
            slot.className = 'ms-saved ' + cls;
            slot.innerHTML = `<span class="ms-saved-row"><span>${label}</span><b>${value}</b></span>${bar(w)}${extra || ''}`;
          };

          if (st && st.isEvaluated) {
            show('is-done', 'Vyhodnotený', score || `${answered}/${total}`, best ? pct(best.correct, bestTotal) : 100);
            cta.textContent = 'Pozrieť výsledok';
            card.setAttribute('href', `/test/${slug}/#vysledok`);
            card.setAttribute('aria-label', `Maturita ${slug.replace('ms-', '')}: vyhodnotený, ${score}. Pozrieť výsledok`);
          } else if (answered > 0) {
            show('is-progress', 'Rozpracovaný', `${answered}/${total} úloh`, pct(answered, total), best ? `<span class="ms-saved-note">Posledný výsledok ${score}</span>` : '');
            cta.textContent = 'Pokračovať';
            card.setAttribute('aria-label', `Maturita ${slug.replace('ms-', '')}: rozpracovaný, ${answered} z ${total} úloh. Pokračovať`);
          } else if (best) {
            show('is-last', 'Posledný výsledok', score, pct(best.correct, bestTotal));
            cta.textContent = 'Skúsiť znova';
          }
        });
      })();

      (function () {
        const CHECK_PATH = '<path d="M20 6 9 17l-5-5"/>';
        const copyBtn = document.getElementById('copyIbanBtn');
        const copyLabel = document.getElementById('copyIbanLabel');
        let copyTimer = null;
        let toastEl = null;
        let toastTimer = null;

        function showToast(msg) {
          if (!toastEl) {
            toastEl = document.createElement('div');
            toastEl.className = 'ms-toast hidden';
            toastEl.setAttribute('role', 'status');
            toastEl.setAttribute('aria-live', 'polite');
            document.body.appendChild(toastEl);
          }
          toastEl.textContent = msg;
          toastEl.classList.remove('hidden');
          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => toastEl.classList.add('hidden'), 2600);
        }

        async function copyText(text) {
          if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
            try {
              await navigator.clipboard.writeText(text);
              return true;
            } catch (e) {}
          }
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            ta.style.pointerEvents = 'none';
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand('copy');
            document.body.removeChild(ta);
            return ok;
          } catch (e) {
            return false;
          }
        }

        if (copyBtn && copyLabel) {
          copyBtn.addEventListener('click', async () => {
            const iban = copyBtn.dataset.iban || 'SK9711000000002930293777';
            const ok = await copyText(iban);
            if (ok) {
              const svg = copyBtn.querySelector('svg');
              if (svg && !copyBtn.dataset.origSvg) copyBtn.dataset.origSvg = svg.innerHTML;
              if (svg) svg.innerHTML = CHECK_PATH;
              copyLabel.textContent = 'Skopírované!';
              copyBtn.classList.add('is-copied');
              showToast('IBAN bol skopírovaný do schránky.');
              clearTimeout(copyTimer);
              copyTimer = setTimeout(() => {
                if (svg && copyBtn.dataset.origSvg) svg.innerHTML = copyBtn.dataset.origSvg;
                copyLabel.textContent = 'Skopírovať IBAN';
                copyBtn.classList.remove('is-copied');
              }, 2400);
            } else {
              window.prompt('Skopíruj IBAN:', iban);
            }
          });
        }

        const legalModal = document.getElementById('legalModal');
        const openLegalBtn = document.getElementById('openLegalBtn');
        const closeLegalBtn = document.getElementById('closeLegalBtn');
        const okLegalBtn = document.getElementById('okLegalBtn');

        function toggleLegal(show) {
          if (!legalModal) return;
          legalModal.classList.toggle('hidden', !show);
          document.body.style.overflow = show ? 'hidden' : '';
          if (show) closeLegalBtn?.focus();
          else openLegalBtn?.focus();
        }

        openLegalBtn?.addEventListener('click', () => toggleLegal(true));
        closeLegalBtn?.addEventListener('click', () => toggleLegal(false));
        okLegalBtn?.addEventListener('click', () => toggleLegal(false));
        legalModal?.addEventListener('click', (e) => {
          if (e.target === legalModal) toggleLegal(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && legalModal && !legalModal.classList.contains('hidden')) {
            toggleLegal(false);
          }
        });

        // Plynulé otváranie a zatváranie FAQ položiek
        const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduceMotion) {
          document.querySelectorAll('.ms-faq-item').forEach((item) => {
            const summary = item.querySelector('summary');
            const body = item.querySelector('.ms-faq-body');
            if (!summary || !body) return;

            summary.addEventListener('click', (e) => {
              e.preventDefault();

              if (item.classList.contains('is-closing')) {
                item.classList.remove('is-closing');
                return;
              }

              if (!item.open) {
                item.classList.add('is-animating-open');
                item.open = true;
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => {
                    item.classList.remove('is-animating-open');
                  });
                });
              } else {
                item.classList.remove('is-animating-open');
                item.classList.add('is-closing');
                const finish = (ev) => {
                  if (ev && ev.target !== body) return;
                  if (!item.classList.contains('is-closing')) return;
                  item.classList.remove('is-closing');
                  item.open = false;
                  body.removeEventListener('transitionend', finish);
                };
                body.addEventListener('transitionend', finish);
                setTimeout(() => finish(), 360);
              }
            });
          });
        }
      })();
    </script>
