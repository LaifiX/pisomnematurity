---
import '../../styles/fonts.css';
import '../../styles/ms.css';
import '../../styles/sloh.css';
import SeoHead from '../../components/SeoHead.astro';
import { ALLOW_INDEXING, SITE_URL } from '../../lib/site';
import MsHeader from '../../components/MsHeader.astro';
import MsFooter from '../../components/MsFooter.astro';
import { slohoveUtvary, temyPre, YEARS, NO_EXAM_YEARS, CRITERIA_COMMON, PROJEKT, PROJEKT_LOGA, LITERATURA, ZDROJE, ZDROJE_NIVAM, youtubeUrl, type SlohovyUtvar } from '../../data/sloh';
import { I, icon } from '../../lib/icons';

export function getStaticPaths() {
  return slohoveUtvary.map((u) => ({ params: { slug: u.slug }, props: { u } }));
}

const { u } = Astro.props as { u: SlohovyUtvar };
const idx = slohoveUtvary.findIndex((x) => x.slug === u.slug);
const prev = slohoveUtvary[(idx - 1 + slohoveUtvary.length) % slohoveUtvary.length];
const next = slohoveUtvary[(idx + 1) % slohoveUtvary.length];
const themes = temyPre(u.slug);
const byYear = new Map(themes.map((t) => [t.year, t]));
const heldYears = YEARS.filter((y) => !NO_EXAM_YEARS.includes(y));
const lastYear = themes.length ? Math.max(...themes.map((t) => t.year)) : null;
const timesWord = (n: number) => (n === 0 ? 'ani raz' : n === 1 ? 'raz' : `${n}-krát`);
const zdroj = ZDROJE[u.slug];
const samples = u.samples ?? (u.sample ? [u.sample] : []);
const utvarJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LearningResource', 'Article'],
      headline: `${u.name.replace(/<[^>]+>/g, '')} – slohový útvar na maturite zo slovenčiny`,
      name: u.name.replace(/<[^>]+>/g, ''),
      description: u.lead.replace(/<[^>]+>/g, ''),
      url: `${SITE_URL}/sloh/${u.slug}/`,
      inLanguage: 'sk',
      learningResourceType: 'Študijný text',
      educationalLevel: 'Stredná škola – maturitný ročník',
      about: 'Písomná forma internej časti maturitnej skúšky zo slovenského jazyka a literatúry',
      author: { '@type': 'Person', name: PROJEKT.author },
      dateModified: `${PROJEKT.updated}`,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      ...(zdroj.prezentacia ? { isBasedOn: { '@type': 'PresentationDigitalDocument', name: zdroj.prezentacia, author: { '@type': 'Person', name: PROJEKT.author }, dateCreated: `${PROJEKT.year}` } } : {})
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Písomné maturity', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Slohové útvary', item: `${SITE_URL}/sloh/` },
        { '@type': 'ListItem', position: 3, name: u.name.replace(/<[^>]+>/g, ''), item: `${SITE_URL}/sloh/${u.slug}/` }
      ]
    }
  ]
};

// obsah stránky (kotvy)
const toc = [
  ...u.sections.map((s) => ({ id: s.id, title: s.title })),
  { id: 'rady', title: 'Dobré rady' },
  ...(samples.length ? [{ id: 'ukazka', title: samples.length > 1 ? 'Ukážky' : 'Ukážka' }] : []),
  { id: 'temy', title: 'Témy z minulých rokov' },
  { id: 'hodnotenie', title: 'Ako sa hodnotí' },
  { id: 'kontrola', title: 'Kontrola pred odovzdaním' },
  { id: 'zdroje', title: 'Pôvod a literatúra' }
];
const num = (id: string) => String(toc.findIndex((t) => t.id === id) + 1).padStart(2, '0');
const pointsWord = (n: number) => `${n} ${n === 1 ? 'bod' : n >= 2 && n < 5 ? 'body' : 'bodov'}`;
const plain = (html: string) => html.replace(/<[^>]+>/g, '');

const checklist = [
  `Moja práca má aspoň ${CRITERIA_COMMON.minWords} slov a najviac 3 strany.`,
  'Dodržal/a som tému a reagujem na všetky kľúčové slová zadania.',
  ...u.checklist,
  'Text je členený na odseky, čitateľný, bez škrtania a s dodržanými okrajmi.',
  'Skontroloval/a som pravopis a diakritiku (Pravidlá a slovníky môžem použiť).'
];
---

<!DOCTYPE html>
<html lang="sk">
  <head>
    <SeoHead
      title={`${plain(u.name)} – maturita zo SJL | Písomné maturity`}
      description={`${plain(u.name)} na maturite zo slovenčiny: znaky, kompozícia, jazyk, dobré rady, témy z rokov 2007 – 2026 a kritériá hodnotenia NIVaM.`}
      path={`/sloh/${u.slug}/`}
      ogImage={`/og/sloh-${u.slug}.png`}
      ogImageAlt={`${plain(u.name)} – slohový útvar na maturite zo slovenčiny`}
      themeColor="#11162d"
      noindex={!ALLOW_INDEXING}
      jsonLd={utvarJsonLd}
    />
  </head>
  <body class="ms">
    <a class="skip-link" href="#obsah">Preskočiť na hlavný obsah</a>
    <MsHeader active="sloh" />

    <main id="obsah">
      <section class="sl-hero">
        <div class="ms-wrap">
          <nav class="sl-crumbs" aria-label="Omrvinková navigácia">
            <a class="sl-back" href="/sloh/" aria-label="Späť na prehľad slohových útvarov"><Fragment set:html={icon(I.arrowLeft)} /><span>Späť</span></a>
            <a href="/">Písomné maturity</a>
            <span aria-hidden="true">/</span>
            <a href="/sloh/">Slohové útvary</a>
            <span aria-hidden="true">/</span>
            <span>{u.name}</span>
          </nav>
          <span class="sl-num">{zdroj.prezentacia ? PROJEKT.series : 'Slohové útvary na maturite'}</span>
          <h1>{u.name}</h1>
          <p class="sl-lead" set:html={u.lead} />
          <dl class="sl-facts">
            {u.facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd set:html={f.value} />
              </div>
            ))}
            <div class="is-accent">
              <dt>Na maturite</dt>
              <dd>{themes.length ? `${timesWord(themes.length)} · naposledy ${lastYear}` : 'zatiaľ nebol'}</dd>
            </div>
          </dl>
          <button class="sl-print-btn" type="button" data-print>
            <Fragment set:html={icon(I.printer)} />
            Vytlačiť ako ťahák
          </button>
        </div>
      </section>

      <div class="ms-wrap sl-layout">
        <aside class="sl-toc" aria-label="Obsah stránky">
          <strong>Obsah</strong>
          <ol>
            {toc.map((t) => (
              <li><a href={`#${t.id}`} set:html={t.title} /></li>
            ))}
          </ol>
        </aside>

        <div class="sl-content">
          {u.sections.map((s) => (
            <section class="sl-sec" id={s.id}>
              <span class="sl-sec-num">{num(s.id)}</span>
              <h2 set:html={s.title} />
              {s.lead && <p class="sl-sec-lead" set:html={s.lead} />}
              {s.list && (
                <ul class="sl-list">
                  {s.list.map((li) => <li set:html={li} />)}
                </ul>
              )}
              {s.cards && (
                <div class="sl-cards">
                  {s.cards.map((c) => (
                    <article class="sl-card">
                      <h3 set:html={c.term} />
                      {c.text && <p set:html={c.text} />}
                      {c.example && <p class="sl-ex" set:html={c.example} />}
                    </article>
                  ))}
                </div>
              )}
              {s.steps && (
                <ol class="sl-steps">
                  {s.steps.map((st) => (
                    <li>
                      <h3 set:html={st.term} />
                      <p set:html={st.text} />
                      {st.example && <p class="sl-ex" set:html={st.example} />}
                    </li>
                  ))}
                </ol>
              )}
              {s.paras && s.paras.map((p) => <p class="sl-para" set:html={p} />)}
            </section>
          ))}

          <section class="sl-sec" id="rady">
            <div class="sl-tips">
              <span class="sl-sec-num">{num('rady')}</span>
              <h2><Fragment set:html={icon(I.bulb)} />Dobré rady</h2>
              <ul class="sl-list">
                {u.tips.map((tip) => <li set:html={tip} />)}
              </ul>
            </div>
          </section>

          {zdroj.video && (
            <aside class="sl-fun" aria-labelledby="sl-fun-title">
              <div class="sl-fun-player">
                <button class="sl-fun-poster" type="button" data-yt={zdroj.video} data-yt-title={`${u.name} – video na oživenie`} aria-label={`Prehrať video na oživenie: ${u.name}`}>
                  <img class="sl-fun-thumb" src={`https://i.ytimg.com/vi/${zdroj.video}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
                  <span class="sl-fun-play" aria-hidden="true"><Fragment set:html={icon(I.play)} /></span>
                </button>
              </div>
              <div class="sl-fun-text">
                <span class="sl-fun-kicker"><Fragment set:html={icon(I.sparkle)} />Na oživenie</span>
                <h2 id="sl-fun-title">Krátke video: {u.name.toLowerCase()}</h2>
                <p>To isté učivo v&nbsp;neformálnej podobe. Ak si chceš oddýchnuť od textu, môžeš si ho pozrieť aj tu. Hodí sa na rýchle zopakovanie útvaru.</p>
                <a href={youtubeUrl(zdroj.video)} target="_blank" rel="noopener noreferrer">Pozrieť na YouTube<Fragment set:html={icon(I.external)} /></a>
              </div>
            </aside>
          )}

          {samples.length > 0 && (
            <section class="sl-sec" id="ukazka">
              <span class="sl-sec-num">{num('ukazka')}</span>
              <h2>{samples.length > 1 ? 'Ukážky' : 'Ukážka'}</h2>
              {samples.map((sm) => (
                <div class="sl-sample-block">
                  <article class="sl-sample">
                    <h3>{sm.title}</h3>
                    {sm.paras.map((p) => <p set:html={p} />)}
                  </article>
                  <p class="sl-sample-note" set:html={sm.note} />
                </div>
              ))}
            </section>
          )}

          <section class="sl-sec" id="temy">
            <span class="sl-sec-num">{num('temy')}</span>
            <h2>Témy z&nbsp;minulých rokov</h2>
            <p class="sl-sec-lead">Každý rok sú na maturite štyri témy, každá v&nbsp;inom slohovom útvare. Pozri sa, v&nbsp;ktorých rokoch bol tento útvar medzi vyžrebovanými.</p>
            <div class="sl-themes-sum">
              <span>Na maturite {timesWord(themes.length)} z&nbsp;{heldYears.length} ročníkov</span>
              {lastYear && <span>Naposledy {lastYear}</span>}
            </div>
            <ol class="sl-years">
              {[...YEARS].reverse().map((y) => {
                const th = byYear.get(y);
                if (NO_EXAM_YEARS.includes(y))
                  return (
                    <li class="sl-year is-none">
                      <span class="sl-year-y">{y}</span>
                      <span class="sl-year-t">písomná maturita sa pre pandémiu v&nbsp;riadnom termíne nekonala</span>
                    </li>
                  );
                if (!th)
                  return (
                    <li class="sl-year">
                      <span class="sl-year-y">{y}</span>
                      <span class="sl-year-t">útvar nebol vyžrebovaný</span>
                    </li>
                  );
                return (
                  <li class="sl-year is-drawn">
                    <span class="sl-year-y">{y}</span>
                    <div class="sl-theme">
                      {th.title.startsWith('„') ? <q>{th.title}</q> : <b>{th.title}</b>}
                      {(th.author || th.spec) && (
                        <small>
                          {th.author && <em>{th.author}</em>}
                          {th.author && th.spec && ' · '}
                          {th.spec && `(${th.spec})`}
                        </small>
                      )}
                    </div>
                  </li>
                );
              })}
            </ol>
            <p class="sl-src">
              Témy 2014 – 2026: zadania NIVaM (NÚCEM), zdroj <a href="https://www2.nucem.sk/sk/merania/narodne-merania/maturita" target="_blank" rel="noopener noreferrer">www2.nucem.sk</a>. Témy 2007 – 2013: prezentácie <cite>{PROJEKT.series}</cite>.
            </p>
          </section>

          <section class="sl-sec" id="hodnotenie">
            <span class="sl-sec-num">{num('hodnotenie')}</span>
            <h2>Ako sa hodnotí</h2>
            <p class="sl-sec-lead">Podľa kritérií NIVaM pre maturitu 2026. Spolu môžeš získať <strong>28 bodov</strong>.</p>
            <div class="sl-score" aria-hidden="true">
              <span>Vonkajšia forma · 4</span>
              <span>Vnútorná forma · 20</span>
              <span>Dojem · 4</span>
            </div>
            <p class="sl-score-total">Vnútorná forma = obsah, kompozícia, jazyk, pravopis a&nbsp;štýl, každé po 4&nbsp;body.</p>
            <div class="sl-warn">
              <Fragment set:html={icon(I.alert)} />
              <span><strong>Pozor:</strong> ak práca nemá aspoň {CRITERIA_COMMON.minWords}&nbsp;slov, hodnotí sa 0&nbsp;bodmi.</span>
            </div>
            <div class="sl-crit">
              <article class="sl-crit-card">
                <header><h3>Vonkajšia forma</h3><span>4 body</span></header>
                <ul>{CRITERIA_COMMON.vonkajsia.map((c) => <li set:html={c} />)}<li>dodržanie rozsahu</li></ul>
              </article>
              <article class="sl-crit-card">
                <header><h3>Obsah</h3><span>4 body</span></header>
                <ul>{u.criteria.obsah.map((c) => <li set:html={c} />)}</ul>
              </article>
              <article class="sl-crit-card">
                <header><h3>Kompozícia</h3><span>4 body</span></header>
                <ul>{u.criteria.kompozicia.map((c) => <li set:html={c} />)}</ul>
              </article>
              <article class="sl-crit-card">
                <header><h3>Jazyk</h3><span>4 body</span></header>
                <ul>{u.criteria.jazyk.map((c) => <li set:html={c} />)}</ul>
              </article>
              <article class="sl-crit-card">
                <header><h3>Pravopis</h3><span>4 body</span></header>
                <table class="sl-pravopis">
                  <tbody>
                    {CRITERIA_COMMON.pravopis.map((r) => (
                      <tr><td>{r.range}</td><td>{pointsWord(r.points)}</td></tr>
                    ))}
                  </tbody>
                </table>
              </article>
              <article class="sl-crit-card">
                <header><h3>Štýl</h3><span>4 body</span></header>
                <ul>{u.criteria.styl.map((c) => <li set:html={c} />)}</ul>
              </article>
              <article class="sl-crit-card">
                <header><h3>Celkový dojem</h3><span>4 body</span></header>
                <ul><li>celkové vyznenie práce</li><li>práca nemá obsahovať: {CRITERIA_COMMON.dojem.join(', ')}</li></ul>
              </article>
            </div>
          </section>

          <section class="sl-sec" id="kontrola">
            <span class="sl-sec-num">{num('kontrola')}</span>
            <h2>Kontrola pred odovzdaním</h2>
            <div class="sl-check-meta">
              <span>Odškrtni si, čo máš splnené. <span data-check-count></span></span>
              <button type="button" data-check-reset>Vymazať</button>
            </div>
            <ul class="sl-check" data-checklist={u.slug}>
              {checklist.map((c, i) => (
                <li>
                  <label>
                    <input type="checkbox" data-i={i} />
                    <span>{c}</span>
                  </label>
                </li>
              ))}
            </ul>
          </section>

          <section class="sl-sec sl-sources" id="zdroje">
            <span class="sl-sec-num">{num('zdroje')}</span>
            <h2>Pôvod a&nbsp;literatúra</h2>
            {zdroj.prezentacia ? (
              <div class="sl-src-card">
                <p class="sl-src-deck"><cite>{zdroj.prezentacia}</cite></p>
                <p class="sl-src-meta">{PROJEKT.author}, {PROJEKT.school}, {PROJEKT.year}. Aktualizované {PROJEKT.updated}.</p>
                <p class="sl-src-eu">
                  Učebný materiál vznikol v&nbsp;projekte <strong>{PROJEKT.name}</strong> {PROJEKT.scope}. {PROJEKT.program}. {PROJEKT.funding}.
                </p>
                <div class="sl-eu-logos is-small">
                  {PROJEKT_LOGA.map((l) => <img src={l.src} alt={l.alt} width={l.width} height={l.height} loading="lazy" decoding="async" />)}
                </div>
              </div>
            ) : (
              <p class="sl-sec-lead">
                {u.name} v&nbsp;sérii prezentácií <cite>{PROJEKT.series}</cite> ({PROJEKT.year}) nebol. Text je pripravený nanovo podľa kritérií NIVaM a&nbsp;rovnakej štruktúry ako ostatné útvary.
              </p>
            )}
            {(zdroj.literatura.length > 0 || (zdroj.ukazky && zdroj.ukazky.length > 0)) && (
              <>
                <h3 class="sl-src-h">Použitá literatúra</h3>
                <ol class="sl-biblio">
                  {zdroj.literatura.map((k) => <li set:html={LITERATURA[k]} />)}
                  {zdroj.ukazky && zdroj.ukazky.map((uSrc) => <li set:html={uSrc} />)}
                </ol>
              </>
            )}
            <h3 class="sl-src-h">Kritériá a&nbsp;témy</h3>
            <ol class="sl-biblio">
              {ZDROJE_NIVAM.map((r) => <li set:html={r} />)}
            </ol>
            <p class="sl-credit">Texty o&nbsp;slohových útvaroch nie sú dielom NIVaM. <a href="/sloh/#povod">Viac o&nbsp;pôvode materiálov</a></p>
          </section>

          <a class="sl-back-all" href="/sloh/"><Fragment set:html={icon(I.arrowLeft)} />Späť na všetky slohové útvary</a>

          <nav class="sl-pager" aria-label="Ďalšie slohové útvary">
            <a href={`/sloh/${prev.slug}/`}><small>← Predchádzajúci</small><strong>{prev.name}</strong></a>
            <a class="is-next" href={`/sloh/${next.slug}/`}><small>Ďalší →</small><strong>{next.name}</strong></a>
          </nav>

        </div>
      </div>
    </main>

    <MsFooter />

    <script is:inline>
      // Tlač: kontrolný zoznam a video sa netlačia (print štýly v sloh.css)
      document.querySelectorAll('[data-print]').forEach(function (b) {
        b.addEventListener('click', function () { window.print(); });
      });

      // Obsah stránky: zvýrazní kapitolu, ktorá je práve na obrazovke
      (function () {
        var links = Array.prototype.slice.call(document.querySelectorAll('.sl-toc a[href^="#"]'));
        var items = links
          .map(function (a) { return { a: a, sec: document.getElementById(a.getAttribute('href').slice(1)) }; })
          .filter(function (x) { return x.sec; });
        if (!items.length) return;
        var current = null;
        function update() {
          var line = window.innerHeight * 0.3;
          var found = null;
          items.forEach(function (x) { if (x.sec.getBoundingClientRect().top <= line) found = x.a; });
          if (found === current) return;
          current = found;
          links.forEach(function (l) {
            if (l === found) l.setAttribute('aria-current', 'location');
            else l.removeAttribute('aria-current');
          });
        }
        var ticking = false;
        window.addEventListener('scroll', function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () { ticking = false; update(); });
        }, { passive: true });
        update();
      })();
    </script>

    <script is:inline>
      // Video: YouTube (youtube-nocookie) sa načíta až po kliknutí na náhľad
      document.querySelectorAll('[data-yt]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var f = document.createElement('iframe');
          f.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(btn.getAttribute('data-yt')) + '?autoplay=1&rel=0';
          f.title = btn.getAttribute('data-yt-title') || 'Video';
          f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
          f.allowFullscreen = true;
          f.referrerPolicy = 'strict-origin-when-cross-origin';
          btn.replaceWith(f);
          f.focus();
        });
      });
    </script>

    <script is:inline>
      // Kontrolný zoznam – stav sa pamätá v prehliadači (len pre pohodlie)
      (function () {
        var list = document.querySelector('[data-checklist]');
        if (!list) return;
        var key = 'maturitasjl_check_' + list.getAttribute('data-checklist');
        var boxes = list.querySelectorAll('input[type=checkbox]');
        var countEl = document.querySelector('[data-check-count]');
        var saved = [];
        try { saved = JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) {}
        function update() {
          var done = [];
          boxes.forEach(function (b) { if (b.checked) done.push(Number(b.getAttribute('data-i'))); });
          if (countEl) countEl.textContent = '(' + done.length + '/' + boxes.length + ')';
          try { localStorage.setItem(key, JSON.stringify(done)); } catch (e) {}
        }
        boxes.forEach(function (b) {
          if (saved.indexOf(Number(b.getAttribute('data-i'))) !== -1) b.checked = true;
          b.addEventListener('change', update);
        });
        var reset = document.querySelector('[data-check-reset]');
        if (reset) reset.addEventListener('click', function () { boxes.forEach(function (b) { b.checked = false; }); update(); });
        update();
      })();
    </script>
  </body>
</html>
