---
import '../../styles/fonts.css';
import '../../styles/ms.css';
import '../../styles/sloh.css';
import SeoHead from '../../components/SeoHead.astro';
import { ALLOW_INDEXING, SITE_URL } from '../../lib/site';
import MsHeader from '../../components/MsHeader.astro';
import MsFooter from '../../components/MsFooter.astro';
import { slohoveUtvary, temy, YEARS, NO_EXAM_YEARS, CRITERIA_COMMON, PROJEKT, PROJEKT_LOGA, LITERATURA, LITERATURA_PORADIE, ZDROJE, ZDROJE_NIVAM } from '../../data/sloh';
import { I, icon } from '../../lib/icons';

const heldYears = YEARS.filter((y) => !NO_EXAM_YEARS.includes(y)).length;
const count = (slug: string) => temy.filter((t) => t.slug === slug).length;
const short = {
  uvaha: 'Úvaha',
  charakteristika: 'Charakteristika',
  'umelecky-opis': 'Umelecký opis',
  rozpravanie: 'Rozprávanie',
  'diskusny-prispevok': 'Diskusný príspevok',
  'beletrizovany-zivotopis': 'Beletr. životopis',
  vyklad: 'Výklad',
  'slavnostny-prejav': 'Slávnostný prejav'
} as Record<string, string>;
const themeAt = (year: number, slug: string) => temy.find((t) => t.year === year && t.slug === slug);
const slohJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Slohové útvary na maturite zo slovenčiny',
      url: `${SITE_URL}/sloh/`,
      inLanguage: 'sk',
      isPartOf: { '@id': `${SITE_URL}/#website` },
      hasPart: slohoveUtvary.map((u) => ({ '@type': 'LearningResource', name: u.name, url: `${SITE_URL}/sloh/${u.slug}/` }))
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Písomné maturity', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Slohové útvary', item: `${SITE_URL}/sloh/` }
      ]
    }
  ]
};
const fromDeck = slohoveUtvary.filter((u) => ZDROJE[u.slug].prezentacia);
const newTexts = slohoveUtvary.filter((u) => !ZDROJE[u.slug].prezentacia);
---

<!DOCTYPE html>
<html lang="sk">
  <head>
    <SeoHead
      title="Slohové útvary na maturite zo SJL | Písomné maturity"
      description="Všetkých 8 slohových útvarov písomnej maturity zo slovenčiny: znaky, kompozícia, jazyk, dobré rady, témy 2007 – 2026 a kritériá hodnotenia NIVaM."
      path="/sloh/"
      ogImage="/og/sloh.png"
      ogImageAlt="Slohové útvary na maturite zo slovenčiny – znaky, kompozícia, jazyk a témy 2007 – 2026"
      themeColor="#11162d"
      noindex={!ALLOW_INDEXING}
      jsonLd={slohJsonLd}
    />
  </head>
  <body class="ms">
    <a class="skip-link" href="#obsah">Preskočiť na hlavný obsah</a>
    <MsHeader active="sloh" />

    <main id="obsah">
      <section class="sl-hero sl-hero-index">
        <div class="ms-wrap">
          <nav class="sl-crumbs" aria-label="Omrvinková navigácia">
            <a class="sl-back" href="/" aria-label="Späť na úvodnú stránku"><Fragment set:html={icon(I.arrowLeft)} /><span>Späť</span></a>
            <a href="/">Písomné maturity</a>
            <span aria-hidden="true">/</span>
            <span>Slohové útvary</span>
          </nav>
          <div class="sl-hero-grid">
            <div>
              <span class="sl-num">Písomná forma internej časti</span>
              <h1>Slohové útvary na maturite</h1>
              <p class="sl-lead">
                Na písomnej maturite sa z&nbsp;ôsmich slohových útvarov vyžrebujú štyri – každý má vlastnú tému a&nbsp;z&nbsp;nich si vyberieš jednu. Pri každom útvare tu nájdeš hlavné znaky, stavbu textu, jazykové prostriedky, praktické rady, ukážku, témy z&nbsp;rokov 2007&nbsp;–&nbsp;2026 aj presné kritériá hodnotenia.
              </p>
            </div>
            <figure class="sl-title-page">
              <div class="sl-tp-stack">
              <div class="sl-tp-sheet" aria-hidden="true"></div>
              <div class="sl-tp-sheet" aria-hidden="true"></div>
              <div class="sl-tp-front">
                <div class="sl-tp-logos">
                  {PROJEKT_LOGA.map((l) => <img src={l.src} alt={l.alt} width={l.width} height={l.height} loading="eager" decoding="async" />)}
                </div>
                <p class="sl-tp-band">{PROJEKT.program}/{PROJEKT.funding}</p>
                <p class="sl-tp-project">Učebný materiál vznikol v&nbsp;projekte <b>{PROJEKT.name}</b> {PROJEKT.scope}</p>
                <p class="sl-tp-title">{PROJEKT.series}</p>
                <p class="sl-tp-author">{PROJEKT.author}<br /><span>{PROJEKT.school}</span></p>
                <p class="sl-tp-place">Trenčín {PROJEKT.year}</p>
                <p class="sl-tp-updated">Aktualizované {PROJEKT.updated}</p>
              </div>
              </div>
              <figcaption>
                Titulná strana pôvodných prezentácií. <a href="#povod">Pôvod a&nbsp;použitá literatúra</a>
              </figcaption>
            </figure>
          </div>
          <dl class="sl-facts">
            <div><dt>Čas</dt><dd>150 minút</dd></div>
            <div><dt>Výber</dt><dd>1 zo 4 tém</dd></div>
            <div><dt>Rozsah</dt><dd>1,5 – 3 strany, min. {CRITERIA_COMMON.minWords} slov</dd></div>
            <div class="is-accent"><dt>Maximum</dt><dd>28 bodov</dd></div>
          </dl>
        </div>
      </section>

      <section class="ms-sec">
        <div class="ms-wrap">
          <div class="ms-sec-head">
            <div>
              <span class="ms-kicker">Obsah</span>
              <h2>Vyber si útvar</h2>
              <p>Spomedzi týchto ôsmich útvarov sa každý rok vyžrebujú štyri maturitné zadania – ku každému vyžrebovanému útvaru jedna téma. V&nbsp;tabuľke si pozri, koľkokrát boli jednotlivé útvary vyžrebované od roku 2007. Po rozkliknutí sa dozvieš viac.</p>
            </div>
          </div>
          <ol class="sl-contents">
            {slohoveUtvary.map((u, idx) => (
              <li>
                <a href={`/sloh/${u.slug}/`}>
                  <span class="sl-c-line">
                    <span class="sl-c-num" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
                    <span class="sl-c-name">{u.name}</span>
                    <span class="sl-c-lead" aria-hidden="true"></span>
                    <span class="sl-c-count">{count(u.slug)}×<span class="sl-sr"> na maturite</span></span>
                  </span>
                  <span class="sl-c-desc" set:html={u.short} />
                </a>
              </li>
            ))}
          </ol>
          <p class="sl-aids">Na písomnej maturite môžeš používať Pravidlá slovenského pravopisu, Synonymický slovník a&nbsp;Krátky slovník slovenského jazyka.</p>
        </div>
      </section>

      <section class="ms-sec ms-sec-alt" id="prehlad">
        <div class="ms-wrap">
          <div class="ms-sec-head">
            <div>
              <span class="ms-kicker">Tabuľka 1</span>
              <h2>Ktoré útvary boli na maturite</h2>
              <p>Bodka znamená, že útvar bol v&nbsp;danom roku medzi štyrmi vyžrebovanými témami. Prejdi myšou alebo ťukni na bodku a&nbsp;uvidíš presné znenie témy.</p>
            </div>
          </div>
          <div class="sl-matrix-wrap">
            <table class="sl-matrix">
              <thead>
                <tr>
                  <th scope="col" style="text-align:left;padding-left:1rem">Rok</th>
                  {slohoveUtvary.map((u) => (
                    <th scope="col"><a href={`/sloh/${u.slug}/`}>{short[u.slug]}</a></th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {[...YEARS].reverse().map((y) =>
                  NO_EXAM_YEARS.includes(y) ? (
                    <tr class="is-noexam">
                      <th scope="row">{y}</th>
                      <td colspan={slohoveUtvary.length}>písomná maturita sa pre pandémiu v&nbsp;riadnom termíne nekonala</td>
                    </tr>
                  ) : (
                    <tr>
                      <th scope="row">{y}</th>
                      {slohoveUtvary.map((u) => {
                        const th = themeAt(y, u.slug);
                        return (
                          <td>
                            {th ? (
                              <button
                                type="button"
                                class="sl-dot sl-dot-btn"
                                data-year={y}
                                data-utvar={u.name}
                                data-title={th.title}
                                data-author={th.author ?? ''}
                                data-spec={th.spec ?? ''}
                                aria-label={`${u.name} (${y}): ${th.title}${th.author ? ` – ${th.author}` : ''}${th.spec ? ` (${th.spec})` : ''}`}
                              />
                            ) : (
                              ''
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  )
                )}
              </tbody>
            </table>
          </div>
          <div class="sl-legend">
            <span><span class="sl-dot" aria-hidden="true"></span> útvar bol vyžrebovaný</span>
            <span>{heldYears} ročníkov, v&nbsp;každom 4 témy</span>
          </div>
        </div>
      </section>

      <section class="ms-sec sl-origin" id="povod">
        <div class="ms-wrap">
          <div class="ms-sec-head">
            <div>
              <span class="ms-kicker">Pôvod a&nbsp;zdroje</span>
              <h2>Z&nbsp;čoho táto časť vychádza</h2>
            </div>
          </div>
          <div class="sl-origin-grid">
            <div class="sl-origin-story">
              <p>
                Texty o&nbsp;slohových útvaroch vychádzajú zo série prezentácií <cite>{PROJEKT.series}</cite>. Pripravil ich {PROJEKT.author} v&nbsp;roku {PROJEKT.year} pre žiakov Strednej odbornej školy podnikania v&nbsp;Trenčíne.
              </p>
              <p>
                Prezentácie vznikli ako učebný materiál v&nbsp;projekte <strong>{PROJEKT.name}</strong>, ktorý bol spolufinancovaný zo zdrojov Európskej únie – z&nbsp;Európskeho sociálneho fondu v&nbsp;rámci Operačného programu Vzdelávanie. Pre web sú upravené, doplnené o&nbsp;témy do roku 2026 a&nbsp;zosúladené s&nbsp;kritériami NIVaM pre maturitu 2026.
              </p>
              <div class="sl-eu-logos">
                {PROJEKT_LOGA.map((l) => <img src={l.src} alt={l.alt} width={l.width} height={l.height} loading="lazy" decoding="async" />)}
              </div>
              <h3>Prezentácie zo série</h3>
              <ul class="sl-decks">
                {fromDeck.map((u) => (
                  <li><a href={`/sloh/${u.slug}/`}>{ZDROJE[u.slug].prezentacia}</a></li>
                ))}
              </ul>
              {newTexts.length > 0 && (
                <p class="sl-origin-note">
                  {newTexts.map((u) => u.name).join(', ')} v&nbsp;sérii z&nbsp;roku {PROJEKT.year} nebol. Text k&nbsp;nemu je pripravený nanovo podľa kritérií NIVaM.
                </p>
              )}
            </div>
            <div class="sl-refs">
              <h3>Použitá literatúra</h3>
              <p class="sl-refs-lead">Tak, ako ju uvádzajú záverečné snímky prezentácií.</p>
              <ol class="sl-biblio">
                {LITERATURA_PORADIE.map((k) => <li set:html={LITERATURA[k]} />)}
              </ol>
              <h3>Oficiálne dokumenty</h3>
              <ol class="sl-biblio">
                {ZDROJE_NIVAM.map((r) => <li set:html={r} />)}
              </ol>
            </div>
          </div>
        </div>
      </section>
    </main>

    <div id="slMatrixTip" class="sl-mtip" role="tooltip" aria-hidden="true">
      <div class="sl-mtip-meta" id="slMatrixTipMeta"></div>
      <div class="sl-mtip-title" id="slMatrixTipTitle"></div>
      <div class="sl-mtip-sub hidden" id="slMatrixTipSub"></div>
      <span class="sl-mtip-arrow" aria-hidden="true"></span>
    </div>

    <MsFooter />

    <script is:inline>
      (function () {
        var tip = document.getElementById('slMatrixTip');
        var metaEl = document.getElementById('slMatrixTipMeta');
        var titleEl = document.getElementById('slMatrixTipTitle');
        var subEl = document.getElementById('slMatrixTipSub');
        var wrap = document.querySelector('.sl-matrix-wrap');
        if (!tip || !metaEl || !titleEl || !subEl) return;

        var activeBtn = null;
        var pinnedByClick = false;

        function placeTip(btn) {
          var r = btn.getBoundingClientRect();
          var cx = r.left + r.width / 2;
          tip.style.left = '0px';
          tip.style.top = '0px';
          var tw = tip.offsetWidth;
          var th = tip.offsetHeight;
          var pad = 12;
          var left = Math.max(pad, Math.min(window.innerWidth - tw - pad, cx - tw / 2));
          var below = r.top < th + 20;
          var top = below ? r.bottom + 12 : r.top - th - 12;
          var arrowX = Math.max(16, Math.min(tw - 16, cx - left));
          tip.classList.toggle('is-below', below);
          tip.style.left = Math.round(left) + 'px';
          tip.style.top = Math.round(top) + 'px';
          tip.style.setProperty('--arrow-x', Math.round(arrowX) + 'px');
        }

        function showFor(btn, pin) {
          if (activeBtn && activeBtn !== btn) activeBtn.classList.remove('is-active');
          activeBtn = btn;
          pinnedByClick = Boolean(pin);
          btn.classList.add('is-active');

          var year = btn.getAttribute('data-year') || '';
          var utvar = btn.getAttribute('data-utvar') || '';
          var title = btn.getAttribute('data-title') || '';
          var author = btn.getAttribute('data-author') || '';
          var spec = btn.getAttribute('data-spec') || '';

          metaEl.textContent = year + ' · ' + utvar;
          titleEl.textContent = title;
          titleEl.classList.toggle('is-quote', title.indexOf('„') === 0);

          if (author || spec) {
            subEl.innerHTML = '';
            if (author) {
              var em = document.createElement('em');
              em.textContent = author;
              subEl.appendChild(em);
            }
            if (author && spec) subEl.appendChild(document.createTextNode(' · '));
            if (spec) {
              var sp = document.createElement('span');
              sp.textContent = '(' + spec + ')';
              subEl.appendChild(sp);
            }
            subEl.classList.remove('hidden');
          } else {
            subEl.textContent = '';
            subEl.classList.add('hidden');
          }

          tip.classList.add('is-open');
          tip.setAttribute('aria-hidden', 'false');
          placeTip(btn);
        }

        function hideTip() {
          if (activeBtn) activeBtn.classList.remove('is-active');
          activeBtn = null;
          pinnedByClick = false;
          tip.classList.remove('is-open');
          tip.setAttribute('aria-hidden', 'true');
        }

        document.querySelectorAll('.sl-dot-btn').forEach(function (btn) {
          btn.addEventListener('pointerenter', function (e) {
            if (e.pointerType === 'touch') return;
            showFor(btn, false);
          });
          btn.addEventListener('pointerleave', function (e) {
            if (e.pointerType === 'touch' || pinnedByClick) return;
            if (activeBtn === btn) hideTip();
          });
          btn.addEventListener('focus', function () {
            showFor(btn, false);
          });
          btn.addEventListener('blur', function () {
            if (!pinnedByClick && activeBtn === btn) hideTip();
          });
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (activeBtn === btn && pinnedByClick) hideTip();
            else showFor(btn, true);
          });
        });

        document.addEventListener('click', function (e) {
          if (activeBtn && !tip.contains(e.target)) hideTip();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && activeBtn) hideTip();
        });
        window.addEventListener('scroll', function () { if (activeBtn) hideTip(); }, { passive: true });
        window.addEventListener('resize', function () { if (activeBtn) hideTip(); }, { passive: true });
        if (wrap) wrap.addEventListener('scroll', function () { if (activeBtn) hideTip(); }, { passive: true });
      })();
    </script>
  </body>
</html>
