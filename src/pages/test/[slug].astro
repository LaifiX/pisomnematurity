      function safeStorageGet(k) {
        try {
          return localStorage.getItem(k);
        } catch (e) {
          return null;
        }
      }

      function safeStorageSet(k, v) {
        try {
          localStorage.setItem(k, v);
        } catch (e) {}
      }

      function safeStorageRemove(k) {
        try {
          localStorage.removeItem(k);
        } catch (e) {}
      }

      function escHtml(s) {
        return String(s ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function inlineMarks(s) {
        return escHtml(s)
          .replace(/(^|[^:])\/\/((?:(?!\/\/)[^\n])+)\/\//g, '$1<em>$2</em>')
          .replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>')
          .replace(/__([^_\n]+)__/g, '<u>$1</u>');
      }

      function formatQuestionText(text) {
        return String(text ?? '')
          .split('\n')
          .map((line) => inlineMarks(line))
          .join('<br />');
      }

      function bindSlovakTypography(root) {
        if (!root || typeof NodeFilter === 'undefined') return;
        const SKIP = new Set(['SCRIPT', 'STYLE', 'CODE', 'PRE', 'INPUT', 'TEXTAREA']);
        const INLINE = new Set(['STRONG', 'EM', 'U', 'B', 'I', 'SPAN', 'A', 'SUB', 'SUP', 'MARK', 'SMALL']);
        // Pevné medzery podľa slovenskej typografie: jednopísmenové predložky a spojky,
        // radová číslovka + slovo (9. ročník), číslo + slovo alebo % (30 úloh, 13,4 %), Testovanie 9
        const PREP = /(^|[\s\u00A0„(\[])([ksvzauoiKSVZAUOI])[ \t\r\n]+(?=\S)/g;
        const PREP_TRAIL = /(^|[\s\u00A0„(\[])([ksvzauoiKSVZAUOI])[ \t\r\n]+$/;
        const RULES = [
          PREP,
          PREP,
          [/(\d+\.)[ \t\r\n]+(?=[\p{L}])/gu, '$1\u00A0'],
          [/(\d+(?:,\d+)?)[ \t\r\n]+(?=[\p{L}%])/gu, '$1\u00A0'],
          [/(Testovani[ea]|Testovaní|Testovaniu|Testovaním)[ \t\r\n]+(?=\d)/g, '$1\u00A0']
        ];
        const hasInlineNext = (node) => {
          const next = node.nextSibling;
          return Boolean(next && next.nodeType === 1 && INLINE.has(next.tagName) && (next.textContent || '').trim() !== '');
        };
        const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            let el = node.parentElement;
            while (el && el !== root) {
              if (SKIP.has(el.tagName)) return NodeFilter.FILTER_REJECT;
              el = el.parentElement;
            }
            const val = node.nodeValue || '';
            if (!val) return NodeFilter.FILTER_SKIP;
            if (hasInlineNext(node) && PREP_TRAIL.test(val)) return NodeFilter.FILTER_ACCEPT;
            for (const entry of RULES) {
              const re = Array.isArray(entry) ? entry[0] : entry;
              re.lastIndex = 0;
              if (re.test(val)) return NodeFilter.FILTER_ACCEPT;
            }
            return NodeFilter.FILTER_SKIP;
          }
        });
        const nodes = [];
        let n;
        while ((n = w.nextNode())) nodes.push(n);
        for (const node of nodes) {
          let t = node.nodeValue;
          for (const entry of RULES) {
            if (Array.isArray(entry)) {
              entry[0].lastIndex = 0;
              t = t.replace(entry[0], entry[1]);
            } else {
              entry.lastIndex = 0;
              t = t.replace(entry, '$1$2\u00A0');
            }
          }
          if (hasInlineNext(node)) {
            t = t.replace(PREP_TRAIL, '$1$2\u00A0');
          }
          node.nodeValue = t;
        }
      }

      function cleanSjlSpacing(raw) {
        return String(raw ?? '')
          .replace(/[\u00A0\u2007\u202F]/g, ' ')
          .replace(/[\u2060\u200B-\u200D\uFEFF]/g, '')
          .replace(/[–—]/g, '-')
          .replace(/\s+/g, ' ')
          .trim()
          .replace(/\.+$/, '')
          .trim();
      }

      function stripDiacritics(str) {
        return String(str ?? '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '');
      }

      function splitWordList(cleaned, keepHyphen = false) {
        const src = keepHyphen ? cleaned.replace(/\s+-\s+/g, ' ') : cleaned;
        const sep = keepHyphen ? /[\s,;.:=+/↔–—·•|]+/ : /[\s,;.:=+\-/↔–—·•|]+/;
        return src
          .split(sep)
          .map((w) => w.trim())
          .filter(Boolean);
      }

      function stripOuterQuotes(raw) {
        return cleanSjlSpacing(String(raw ?? '').trim().replace(/^[„"”‚'’«»]+|[“"”‘'’«»]+$/g, ''));
      }

      function isQuestionCorrect(q, rawAns) {
        const cleaned = cleanSjlSpacing(rawAns);
        if (!cleaned) return false;

        if (q.type === 'choice') {
          return cleaned.toUpperCase() === cleanSjlSpacing(q.acceptedAnswers[0]).toUpperCase();
        }

        if (Array.isArray(q.orderedWords) && q.orderedWords.length > 0) {
          const keepHyphen = q.orderedWords.some((w) => w.includes('-'));
          const words = splitWordList(cleaned, keepHyphen).map((w) => (q.caseSensitive ? w : w.toLocaleLowerCase('sk')));
          const target = q.orderedWords.map((w) => (q.caseSensitive ? w : w.toLocaleLowerCase('sk')));
          if (words.length !== target.length) return false;
          return words.every((w, idx) => w === target[idx]);
        }

        if (Array.isArray(q.unorderedWords) && q.unorderedWords.length > 0) {
          const keepHyphen = q.unorderedWords.some((w) => w.includes('-'));
          const words = splitWordList(cleaned, keepHyphen)
            .map((w) => (q.caseSensitive ? w : w.toLocaleLowerCase('sk')))
            .sort((a, b) => a.localeCompare(b, 'sk'));
          const target = q.unorderedWords
            .map((w) => (q.caseSensitive ? w : w.toLocaleLowerCase('sk')))
            .sort((a, b) => a.localeCompare(b, 'sk'));
          if (words.length !== target.length) return false;
          return words.every((w, idx) => w === target[idx]);
        }

        const accepted = Array.isArray(q.acceptedAnswers) ? q.acceptedAnswers : [];
        if (q.caseSensitive) {
          return accepted.some((acc) => cleaned === cleanSjlSpacing(acc));
        }

        const low = cleaned.toLocaleLowerCase('sk');
        return accepted.some((acc) => low === cleanSjlSpacing(acc).toLocaleLowerCase('sk'));
      }

      function diagnoseNearMiss(q, rawAns) {
        const cleaned = cleanSjlSpacing(rawAns);
        if (!cleaned || q.type !== 'text') return '';

        const unquoted = stripOuterQuotes(rawAns);
        if (unquoted && unquoted !== cleaned) {
          if (isQuestionCorrect(q, unquoted)) return 'Odpoveď píš bez úvodzoviek.';
        }

        const candidate = unquoted || cleaned;

        if (Array.isArray(q.orderedWords) && q.orderedWords.length > 0) {
          const keepHyphen = q.orderedWords.some((w) => w.includes('-'));
          const rawWords = splitWordList(candidate, keepHyphen);
          const words = rawWords.map((w) => w.toLocaleLowerCase('sk'));
          const target = q.orderedWords.map((w) => w.toLocaleLowerCase('sk'));
          const sortedTarget = [...target].sort((a, b) => a.localeCompare(b, 'sk'));

          if (words.length > target.length) {
            const withoutConj = words.filter((w) => w !== 'a' && w !== 'i');
            if (withoutConj.length === target.length) {
              if (withoutConj.every((w, i) => w === target[i])) {
                return 'Vypíš len samotné hľadané slová bez spojky „a“ (oddelené napr. čiarkou).';
              }
              const sortedNoConj = [...withoutConj].sort((a, b) => a.localeCompare(b, 'sk'));
              if (sortedNoConj.every((w, i) => w === sortedTarget[i])) {
                return 'Vypíš len samotné slová bez spojky „a“ a zoraď ich v abecednom poradí.';
              }
            }
          }

          if (words.length === target.length) {
            if (q.caseSensitive && words.every((w, i) => w === target[i])) {
              return q.caseHint || 'Pozor na malé a veľké začiatočné písmená.';
            }
            const sortedUser = [...words].sort((a, b) => a.localeCompare(b, 'sk'));
            if (sortedUser.every((w, i) => w === sortedTarget[i])) {
              const countPhrase =
                target.length === 2 ? 'obe slová' : target.length <= 4 ? `všetky ${target.length} slová` : `všetkých ${target.length} slov`;
              return `Máš správne ${countPhrase}, ale zadanie žiada vypísať ich v abecednom poradí.`;
            }
            if (words.every((w, i) => stripDiacritics(w) === stripDiacritics(target[i]))) {
              return 'Slová máš v správnom poradí, ale chýba alebo nesedí diakritika (dĺžne či mäkčene).';
            }
            const strippedUser = words.map(stripDiacritics).sort((a, b) => a.localeCompare(b, 'sk'));
            const strippedTarget = target.map(stripDiacritics).sort((a, b) => a.localeCompare(b, 'sk'));
            if (strippedUser.every((w, i) => w === strippedTarget[i])) {
              return 'Slová sú blízko, skontroluj správnu slovenskú diakritiku a abecedné poradie.';
            }
          }

          const mistake = (q.commonMistakes || []).find((m) => {
            try {
              return new RegExp(m.pattern, 'i').test(candidate);
            } catch (e) {
              return false;
            }
          });
          if (mistake) return mistake.hint;

          if (words.length < target.length) {
            const countPhrase = target.length === 2 ? 'obe hľadané slová' : `všetky ${target.length} hľadané slová`;
            return `Zadanie žiada uviesť ${countPhrase}.`;
          }
          return '';
        }

        if (Array.isArray(q.unorderedWords) && q.unorderedWords.length > 0) {
          const keepHyphen = q.unorderedWords.some((w) => w.includes('-'));
          const rawWords = splitWordList(candidate, keepHyphen);
          const words = rawWords.map((w) => w.toLocaleLowerCase('sk'));
          const target = q.unorderedWords.map((w) => w.toLocaleLowerCase('sk'));
          const sortedTarget = [...target].sort((a, b) => a.localeCompare(b, 'sk'));

          if (words.length > target.length) {
            const withoutConj = words.filter((w) => w !== 'a' && w !== 'i');
            const sortedNoConj = [...withoutConj].sort((a, b) => a.localeCompare(b, 'sk'));
            if (withoutConj.length === target.length && sortedNoConj.every((w, i) => w === sortedTarget[i])) {
              return 'Vypíš len samotné hľadané slová bez spojky „a“ (oddelené napr. čiarkou).';
            }
          }

          if (words.length === target.length) {
            const sortedUser = [...words].sort((a, b) => a.localeCompare(b, 'sk'));
            if (q.caseSensitive && sortedUser.every((w, i) => w === sortedTarget[i])) {
              return q.caseHint || 'Pozor na malé a veľké začiatočné písmená.';
            }
            const strippedUser = words.map(stripDiacritics).sort((a, b) => a.localeCompare(b, 'sk'));
            const strippedTarget = target.map(stripDiacritics).sort((a, b) => a.localeCompare(b, 'sk'));
            if (strippedUser.every((w, i) => w === strippedTarget[i])) {
              return 'Slová máš takmer správne, ale chýba alebo nesedí diakritika (dĺžne či mäkčene).';
            }
          }

          const mistake = (q.commonMistakes || []).find((m) => {
            try {
              return new RegExp(m.pattern, 'i').test(candidate);
            } catch (e) {
              return false;
            }
          });
          if (mistake) return mistake.hint;

          if (words.length < target.length) {
            const countPhrase = target.length === 2 ? 'obe hľadané slová' : `všetky ${target.length} hľadané slová`;
            return `Zadanie žiada uviesť ${countPhrase}.`;
          }
          return '';
        }

        const accepted = Array.isArray(q.acceptedAnswers) ? q.acceptedAnswers : [];

        if (q.caseSensitive) {
          const ciMatch = accepted.some((acc) => candidate.toLocaleLowerCase('sk') === cleanSjlSpacing(acc).toLocaleLowerCase('sk'));
          if (ciMatch) return q.caseHint || 'Pozor na malé a veľké začiatočné písmeno.';
        }

        const strippedUser = stripDiacritics(candidate).toLocaleLowerCase('sk');
        const noDiacMatch = accepted.some((acc) => strippedUser === stripDiacritics(cleanSjlSpacing(acc)).toLocaleLowerCase('sk'));
        if (noDiacMatch) {
          const caseAlsoWrong =
            q.caseSensitive && !accepted.some((acc) => stripDiacritics(candidate) === stripDiacritics(cleanSjlSpacing(acc)));
          if (caseAlsoWrong) return 'Skontroluj diakritiku (dĺžne, mäkčene) aj veľkosť začiatočného písmena.';
          return 'Odpoveď máš takmer správne, ale chýba alebo nesedí diakritika (dĺžne či mäkčene).';
        }

        // Typické chyby konkrétnej úlohy (pole commonMistakes v dátach testu)
        const mistake = (q.commonMistakes || []).find((m) => {
          try {
            return new RegExp(m.pattern, 'i').test(candidate);
          } catch (e) {
            return false;
          }
        });
        return mistake ? mistake.hint : '';
      }

