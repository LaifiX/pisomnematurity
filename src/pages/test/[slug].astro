      function loadStateFromStorage() {
        try {
          const raw = safeStorageGet(STORAGE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (e) {
          return null;
        }
      }

      function clearSavedState() {
        safeStorageRemove(STORAGE_KEY);
      }

      // Časovač
      function formatTime(sec) {
        const s = Math.max(0, Math.floor(sec));
        const mm = String(Math.floor(s / 60)).padStart(2, '0');
        const ss = String(s % 60).padStart(2, '0');
        return `${mm}:${ss}`;
      }

      function updateTimerUI() {
        if (!mode) return;
        const val = mode === 'exam' ? remainingSeconds : elapsedSeconds;
        timerDisplay.textContent = formatTime(val);
        timerWidget.classList.toggle('is-warn', mode === 'exam' && remainingSeconds <= 300);
        timerToggleBtn.innerHTML = timerRunning ? UI.pause : UI.play;
      }

      function stopTimer() {
        if (timerInterval) {
          clearInterval(timerInterval);
          timerInterval = null;
        }
      }

      function startTimer() {
        stopTimer();
        timerRunning = true;
        updateTimerUI();
        timerInterval = setInterval(() => {
          if (!timerRunning || !mode || isEvaluated) return;
          if (mode === 'exam') {
            remainingSeconds = Math.max(0, remainingSeconds - 1);
            updateTimerUI();
            if (remainingSeconds <= 0) {
              stopTimer();
              evaluateTest(true);
            }
          } else {
            elapsedSeconds += 1;
            updateTimerUI();
          }
          if ((mode === 'exam' ? remainingSeconds : elapsedSeconds) % 5 === 0) {
            saveStateToStorage();
          }
        }, 1000);
      }

      timerToggleBtn.addEventListener('click', () => {
        playSound('click');
        timerRunning = !timerRunning;
        updateTimerUI();
      });

      timerResetBtn.addEventListener('click', () => {
        playSound('click');
        if (mode === 'exam') remainingSeconds = INITIAL_SECONDS;
        else elapsedSeconds = 0;
        updateTimerUI();
        saveStateToStorage();
      });

      // Režimy a intro
      function updateModeUI() {
        if (!mode) return;
        const locked = isExamLocked();
        const isExam = mode === 'exam';
        modeChip.textContent = isExam ? 'Ostrý test' : 'Precvičovanie';
        modeChip.classList.toggle('is-exam', isExam);

        openHintBtn.disabled = locked;
        openSolutionBtn.disabled = locked;
        const lockedTitle = 'V ostrom teste sa odomkne po vyhodnotení';
        openHintBtn.title = locked ? lockedTitle : 'Nápoveda k úlohe';
        openSolutionBtn.title = locked ? lockedTitle : 'Postup riešenia';

        checkSingleBtn.classList.toggle('hidden', isExam || isEvaluated);
        timerResetBtn.classList.toggle('hidden', isExam);
        evaluateBtnLabel.textContent = isEvaluated ? 'Výsledkový panel' : 'Vyhodnotiť test';
        document.getElementById('evaluateBtnShort').textContent = isEvaluated ? 'Výsledok' : 'Vyhodnotiť';
      }

      function enterWorkspace(selectedMode, fromRestore = false) {
        mode = selectedMode;
        document.body.classList.remove('tp-intro-active');
        introScreen.classList.add('hidden');
        stepperCard.classList.remove('hidden');
        workspace.classList.remove('hidden');

        if (!fromRestore) {
          remainingSeconds = INITIAL_SECONDS;
          elapsedSeconds = 0;
          currentIndex = 0;
        }

        updateModeUI();
        renderQuestion();
        if (isEvaluated) {
          resultsDashboard.classList.remove('hidden');
          renderResultsBreakdownAndPrintReport();
          stopTimer();
          updateTimerUI();
        } else {
          resultsDashboard.classList.add('hidden');
          startTimer();
        }
        saveStateToStorage();
        // Po otvorení testu (nový aj pokračovanie) začína stránka na začiatku ukážky
        // (úloha bez ukážky – na úlohe); vyhodnotený test na výsledku
        requestAnimationFrame(() => {
          syncHeaderHeight();
          if (isEvaluated) resultsDashboard.scrollIntoView({ block: 'start' });
          else workspace.scrollIntoView({ block: 'start' });
        });
      }

      function clearAnswerObjects() {
        Object.keys(userAnswers).forEach((k) => delete userAnswers[k]);
        Object.keys(singleCheckedState).forEach((k) => delete singleCheckedState[k]);
        Object.keys(flaggedQuestions).forEach((k) => delete flaggedQuestions[k]);
      }

      function clearArchiveView(stripHash = true) {
        viewingArchive = false;
        document.getElementById('archiveNote').classList.add('hidden');
        if (stripHash && window.location.hash === '#vysledok') {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }

      function resetAnswers() {
        clearArchiveView(true);
        clearSavedState();
        clearAnswerObjects();
        isEvaluated = false;
        filterWrongOnly = false;
      }

      function startFresh(selectedMode) {
        playSound('click');
        const saved = loadStateFromStorage();
        const savedFilled =
          saved && saved.userAnswers ? Object.values(saved.userAnswers).filter((v) => String(v).trim() !== '').length : 0;
        const begin = () => {
          resetAnswers();
          enterWorkspace(selectedMode, false);
        };
        // Uložený rozpracovaný test sa nesmie stratiť jedným nechceným kliknutím
        if (savedFilled > 0) {
          const savedPart = savedFilled === 1 ? 'uloženú' : savedFilled <= 4 ? 'uložené' : 'uložených';
          const savedPron = savedFilled === 1 ? 'ju' : 'ich';
          openConfirm({
            eyebrow: 'Uložený postup',
            title: 'Začať nový test?',
            html: `<p class="tp-confirm-lead">Máš ${savedPart} <strong>${savedFilled} z ${questions.length}</strong> odpovedí. Nový test ${savedPron} vymaže.</p>`,
            proceedLabel: 'Áno, začať nový',
            onProceed: begin
          });
          return;
        }
        begin();
      }

      document.getElementById('startExamModeBtn').addEventListener('click', () => startFresh('exam'));
      document.getElementById('startPracticeModeBtn').addEventListener('click', () => startFresh('practice'));

      document.getElementById('changeModeBtn').addEventListener('click', () => {
        playSound('click');
        stopTimer();
        clearArchiveView(true);
        mode = null;
        document.body.classList.add('tp-intro-active');
        introScreen.classList.remove('hidden');
        stepperCard.classList.add('hidden');
        workspace.classList.add('hidden');
        resultsDashboard.classList.add('hidden');
        wrongModeBanner.classList.add('hidden');
        refreshIntroResumeBox();
      });

      function refreshIntroResumeBox() {
        const saved = loadStateFromStorage();
        const box = document.getElementById('introResumeBox');
        const txt = document.getElementById('introResumeText');
        if (!saved || !saved.mode) {
          box.classList.add('hidden');
          return;
        }
        const filled = Object.keys(saved.userAnswers || {}).filter((k) => String(saved.userAnswers[k]).trim() !== '').length;
        const mLabel = saved.mode === 'exam' ? 'ostrý test' : 'test v režime precvičovania';
        txt.innerHTML = `Máš uložený <strong>${mLabel}</strong> (${filled}/${questions.length} vyplnených úloh${saved.isEvaluated ? ', vyhodnotený' : ''}).`;
        box.classList.remove('hidden');
      }

      document.getElementById('resumeSavedBtn').addEventListener('click', () => {
        const saved = loadStateFromStorage();
        if (!saved || !saved.mode) return;
        playSound('click');
        clearArchiveView(!saved.isEvaluated);
        clearAnswerObjects();
        Object.assign(userAnswers, saved.userAnswers || {});
        Object.assign(singleCheckedState, saved.singleCheckedState || {});
        Object.assign(flaggedQuestions, saved.flaggedQuestions || {});
        isEvaluated = Boolean(saved.isEvaluated);
        filterWrongOnly = Boolean(saved.filterWrongOnly);
        studentName = saved.studentName || '';
        studentNameInput.value = studentName;
        currentIndex = Math.max(0, Math.min(LAST_INDEX, saved.currentIndex || 0));
        remainingSeconds = typeof saved.remainingSeconds === 'number' ? saved.remainingSeconds : INITIAL_SECONDS;
        elapsedSeconds = typeof saved.elapsedSeconds === 'number' ? saved.elapsedSeconds : 0;
        enterWorkspace(saved.mode, true);
      });

      document.getElementById('discardSavedBtn').addEventListener('click', () => {
        playSound('click');
        clearSavedState();
        refreshIntroResumeBox();
      });

      // Stepper
      stepperToggleBtn.addEventListener('click', () => {
        const collapsed = stepperCard.classList.toggle('is-collapsed');
        stepperToggleBtn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      });

      stepPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          playSound('click');
          goToQuestion(Number(pill.getAttribute('data-step-idx')));
        });
      });

      function hasAnswer(q) {
        const val = userAnswers[q.id];
        return val !== undefined && String(val).trim() !== '';
      }

      function getWrongQuestionIndices() {
        return questions
          .map((q, idx) => (isQuestionCorrect(q, userAnswers[q.id]) ? -1 : idx))
          .filter((idx) => idx >= 0);
      }

      function updateProgressAndStepper() {
        let answeredCount = 0;
        questions.forEach((q, idx) => {
          const answered = hasAnswer(q);
          if (answered) answeredCount++;

          const pill = stepPills[idx];
          if (!pill) return;
          pill.classList.remove('is-active', 'is-done', 'is-ok', 'is-err', 'is-flag');
          if (idx === currentIndex) pill.classList.add('is-active');
          if (flaggedQuestions[q.id]) pill.classList.add('is-flag');

          if (isEvaluated) {
            pill.classList.add(isQuestionCorrect(q, userAnswers[q.id]) ? 'is-ok' : 'is-err');
          } else if (mode === 'practice' && singleCheckedState[q.id]) {
            pill.classList.add(singleCheckedState[q.id] === 'correct' ? 'is-ok' : 'is-err');
          } else if (answered) {
            pill.classList.add('is-done');
          }

          const hidePill = isEvaluated && filterWrongOnly && isQuestionCorrect(q, userAnswers[q.id]);
          pill.classList.toggle('hidden', hidePill);
        });

        progressText.textContent = `${answeredCount}/${questions.length}`;
        headerProgressFill.style.width = `${Math.round((answeredCount / questions.length) * 100)}%`;
        wrongModeBanner.classList.toggle('hidden', !(isEvaluated && filterWrongOnly));
      }

      function goToQuestion(idx) {
        if (idx < 0 || idx > LAST_INDEX) return;
        currentIndex = idx;
        renderQuestion();
        saveStateToStorage();
        // Na mobile a tablete: ak je začiatok novej úlohy mimo obrazovky, posuň naň
        if (stackedLayout.matches) {
          const top = document.getElementById('questionCard').getBoundingClientRect().top;
          const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--tp-header-h')) || 64;
          if (top < headerH || top > window.innerHeight * 0.6) scrollToQuestion('smooth');
        }
      }

      // Posun stránky tak, aby začiatok úlohy bol hneď pod hlavičkou
      function scrollToQuestion(behavior = 'auto') {
        const card = document.getElementById('questionCard');
        const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--tp-header-h')) || 64;
        const top = card.getBoundingClientRect().top + window.scrollY - headerH - 12;
        window.scrollTo({ top: Math.max(0, top), behavior });
      }

      // Zoom obrázkov
      function openZoomWithHtml(html) {
        zoomContent.innerHTML = html;
        zoomModal.classList.remove('hidden');
      }

      function closeZoom() {
        zoomModal.classList.add('hidden');
        zoomContent.innerHTML = '';
      }

      closeZoomBtn.addEventListener('click', closeZoom);
      zoomModal.addEventListener('click', (e) => {
        if (e.target === zoomModal) closeZoom();
      });

      function wireZoomables(container) {
        container.querySelectorAll('.sjl-figure').forEach((fig) => {
          fig.setAttribute('title', 'Kliknutím zväčšíš graf alebo ilustráciu');
          fig.addEventListener('click', () => {
            openZoomWithHtml(fig.innerHTML);
          });
        });
      }

      // Skladanie spoločnej ukážky
      ctxToggleBtn.addEventListener('click', () => {
        const q = questions[currentIndex];
        if (!q || !q.sharedContextId) return;
        const nextCollapsed = !sharedContextCard.classList.contains('is-collapsed');
        collapsedContexts[q.sharedContextId] = nextCollapsed;
        sharedContextCard.classList.toggle('is-collapsed', nextCollapsed);
        ctxToggleBtn.setAttribute('aria-expanded', nextCollapsed ? 'false' : 'true');
      });

      function renderSharedContext(q) {
        if (!q.sharedContextId || !passages[q.sharedContextId]) {
          sharedContextContainer.classList.add('hidden');
          workspace.classList.remove('has-ctx');
          sharedContextBody.innerHTML = '';
          return;
        }
        const passage = passages[q.sharedContextId];
        sharedContextContainer.classList.remove('hidden');
        workspace.classList.add('has-ctx');
        ctxToggleLabel.textContent = passage.label;
        const isCollapsed = Boolean(collapsedContexts[q.sharedContextId]);
        sharedContextCard.classList.toggle('is-collapsed', isCollapsed);
        ctxToggleBtn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
        sharedContextBody.innerHTML = passage.html;
        wireZoomables(sharedContextBody);
        bindSlovakTypography(sharedContextBody);
      }

      // Renderovanie aktuálnej úlohy
      function selectChoice(key) {
        if (isEvaluated) return;
        const q = questions[currentIndex];
        playSound('select', ['A', 'B', 'C', 'D'].indexOf(key));
        userAnswers[q.id] = key;
        if (singleCheckedState[q.id]) delete singleCheckedState[q.id];
        saveStateToStorage();
        renderQuestion();
      }

      function renderQuestion() {
        const q = questions[currentIndex];
        if (!q) return;

        if (lastRenderedIndex !== currentIndex) {
          questionCard.classList.remove('is-entering');
          void questionCard.offsetWidth;
          questionCard.classList.add('is-entering');
          lastRenderedIndex = currentIndex;
        }

        renderSharedContext(q);

        qNumberBadge.textContent = `Úloha ${q.code}`;
        qCategoryBadge.textContent = q.category;
        qTypeBadge.textContent = q.type === 'choice' ? 'Výber A\u00A0–\u00A0D' : 'Krátka odpoveď';

        const isFlagged = Boolean(flaggedQuestions[q.id]);
        flagQuestionBtn.classList.toggle('is-flagged', isFlagged);
        flagQuestionBtnText.textContent = isFlagged ? 'Označené' : 'Označiť';

        questionText.innerHTML = formatQuestionText(q.questionText);

        if (q.diagramId && diagrams[q.diagramId]) {
          questionDiagramContainer.innerHTML = diagrams[q.diagramId];
          wireZoomables(questionDiagramContainer);
        } else {
          questionDiagramContainer.innerHTML = '';
        }

        if (q.questionTextAfter) {
          questionTextAfter.innerHTML = formatQuestionText(q.questionTextAfter);
          questionTextAfter.classList.remove('hidden');
        } else {
          questionTextAfter.innerHTML = '';
          questionTextAfter.classList.add('hidden');
        }

        const currentVal = userAnswers[q.id] ?? '';
        const checkedStatus = singleCheckedState[q.id];

        if (q.type === 'choice') {
          answerSection.innerHTML = `
            <div class="tp-choices" role="radiogroup" aria-label="Možnosti odpovede">
              ${(q.options || [])
                .map((opt) => {
                  const isSel = String(currentVal).toUpperCase() === opt.key;
                  const cls = ['tp-choice'];
                  if (isEvaluated) {
                    if (opt.key === q.correctAnswerDisplay) cls.push('is-correct');
                    else if (isSel) cls.push('is-wrong');
                  } else if (mode === 'practice' && checkedStatus) {
                    if (isSel && checkedStatus === 'correct') cls.push('is-correct');
                    else if (isSel && checkedStatus === 'wrong') cls.push('is-wrong');
                  } else if (isSel) {
                    cls.push('is-selected');
                  }
                  return `
                    <button
                      type="button"
                      class="${cls.join(' ')}"
                      data-choice-key="${opt.key}"
                      role="radio"
                      aria-checked="${isSel ? 'true' : 'false'}"
                      ${isEvaluated ? 'disabled' : ''}
                    >
                      <span class="tp-choice-key">${opt.key}</span>
                      <span>${inlineMarks(opt.text)}</span>
                    </button>
                  `;
                })
                .join('')}
            </div>
          `;
          answerSection.querySelectorAll('[data-choice-key]').forEach((btn) => {
            btn.addEventListener('click', () => selectChoice(btn.getAttribute('data-choice-key')));
          });
        } else {
          const inputCls = ['tp-input'];
          if (q.fillSentenceHtml) inputCls.push('tp-input-inline');
          if (isEvaluated) {
            inputCls.push(isQuestionCorrect(q, currentVal) ? 'is-correct' : 'is-wrong');
          } else if (mode === 'practice' && checkedStatus) {
            inputCls.push(checkedStatus === 'correct' ? 'is-correct' : 'is-wrong');
          }

          const inputHtml = `
            <input
              type="text"
              id="textAnswerInput"
              class="${inputCls.join(' ')}"
              aria-label="${escHtml(q.placeholder || 'Napíš odpoveď')}"
              placeholder="${escHtml(q.placeholder || 'Napíš odpoveď')}"
              value="${escHtml(currentVal)}"
              autocomplete="off"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              ${isEvaluated ? 'disabled' : ''}
            />
          `;

          if (q.fillSentenceHtml) {
            const sentenceWithBlank = inlineMarks(q.fillSentenceHtml).replace('{{blank}}', inputHtml);
            answerSection.innerHTML = `<div class="tp-fill-sentence">${sentenceWithBlank}</div>`;
          } else {
            answerSection.innerHTML = `<div class="tp-answer-row">${inputHtml}</div>`;
          }

          if (q.footnote) {
            answerSection.insertAdjacentHTML('beforeend', `<p class="tp-footnote">* ${escHtml(q.footnote)}</p>`);
          }

          const inp = document.getElementById('textAnswerInput');
          if (inp) {
            inp.addEventListener('input', () => {
              userAnswers[q.id] = inp.value;
              if (singleCheckedState[q.id]) {
                delete singleCheckedState[q.id];
                inp.classList.remove('is-correct', 'is-wrong');
                evalFeedbackBanner.classList.add('hidden');
              }
              updateProgressAndStepper();
              saveStateToStorage();
            });
            inp.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' && !isEvaluated) {
                e.preventDefault();
                if (mode === 'practice') checkCurrentQuestionImmediately();
                else if (currentIndex < LAST_INDEX) goToQuestion(currentIndex + 1);
              }
            });
          }
        }

        // Spätná väzba (vyhodnotený test alebo okamžitá kontrola v Precvičovaní)
        evalFeedbackBanner.classList.remove('hidden', 'is-ok', 'is-err', 'is-warn');
        evalOpenSolutionBtn.classList.add('hidden');

        if (isEvaluated) {
          const ok = isQuestionCorrect(q, currentVal);
          const nearMiss = !ok ? diagnoseNearMiss(q, currentVal) : '';
          evalFeedbackBanner.classList.add(ok ? 'is-ok' : 'is-err');
          evalFeedbackIcon.innerHTML = ok ? UI.checkCircle : UI.xCircle;
          evalFeedbackInfo.innerHTML = ok
            ? `<strong>Správne! (+1 bod)</strong> Tvoja odpoveď zodpovedá oficiálnemu kľúču (${escHtml(q.correctAnswerDisplay)}).`
            : `<strong>Nesprávne (0 bodov).</strong> ${currentVal ? `Tvoja odpoveď: <b>${escHtml(currentVal)}</b>. ` : 'Nezodpovedané. '}Správna odpoveď: <b>${escHtml(q.correctAnswerDisplay)}</b>.${nearMiss ? `<span class="tp-feedback-note">${escHtml(nearMiss)}</span>` : ''}`;
          evalOpenSolutionBtn.classList.remove('hidden');
        } else if (mode === 'practice' && checkedStatus) {
          if (checkedStatus === 'correct') {
            evalFeedbackBanner.classList.add('is-ok');
            evalFeedbackIcon.innerHTML = UI.checkCircle;
            evalFeedbackInfo.innerHTML = `<strong>Výborne, správne!</strong> Odpoveď <b>${escHtml(q.correctAnswerDisplay)}</b> je správna.`;
          } else {
            const nearMiss = diagnoseNearMiss(q, currentVal);
            evalFeedbackBanner.classList.add('is-err');
            evalFeedbackIcon.innerHTML = UI.xCircle;
            evalFeedbackInfo.innerHTML = `<strong>Zatiaľ nesprávne.</strong> ${nearMiss ? escHtml(nearMiss) : 'Skús si pozrieť nápovedu alebo postup riešenia.'}`;
            evalOpenSolutionBtn.classList.remove('hidden');
          }
        } else {
          evalFeedbackBanner.classList.add('hidden');
        }

        // Dolná navigácia
        footerPositionText.textContent = `${currentIndex + 1} / ${questions.length}`;
        if (isEvaluated && filterWrongOnly) {
          const wrongs = getWrongQuestionIndices();
          const prevW = [...wrongs].reverse().find((i) => i < currentIndex);
          const nextW = wrongs.find((i) => i > currentIndex);
          prevQuestionBtn.disabled = prevW === undefined;
          nextQuestionBtn.disabled = nextW === undefined;
          nextBtnText.textContent = 'Ďalšia chybná';
          nextBtnArrow.innerHTML = UI.arrow;
        } else {
          prevQuestionBtn.disabled = currentIndex === 0;
          nextQuestionBtn.disabled = isEvaluated && currentIndex === LAST_INDEX;
          if (!isEvaluated && currentIndex === LAST_INDEX) {
            nextBtnText.textContent = 'Vyhodnotiť test';
            nextBtnArrow.innerHTML = UI.checkCircle;
          } else {
            nextBtnText.textContent = 'Ďalšia úloha';
            nextBtnArrow.innerHTML = UI.arrow;
          }
        }

        updateModeUI();
        updateProgressAndStepper();
        bindSlovakTypography(questionCard);
      }

      // Okamžité overenie v režime Precvičovanie
      function checkCurrentQuestionImmediately() {
        if (isExamLocked() || isEvaluated) return;
        const q = questions[currentIndex];
        const raw = userAnswers[q.id];
        if (cleanSjlSpacing(raw) === '') {
          playSound('wrong');
          evalFeedbackBanner.classList.remove('hidden', 'is-ok', 'is-err');
          evalFeedbackBanner.classList.add('is-warn');
          evalFeedbackIcon.innerHTML = UI.alert;
          evalFeedbackInfo.innerHTML = '<strong>Najprv vyber alebo zapíš odpoveď.</strong>';
          evalOpenSolutionBtn.classList.add('hidden');
          announce('Najprv vyber alebo zapíš odpoveď.');
          return;
        }
        const ok = isQuestionCorrect(q, raw);
        singleCheckedState[q.id] = ok ? 'correct' : 'wrong';
        playSound(ok ? 'correct' : 'wrong');
        saveStateToStorage();
        renderQuestion();
        announce(ok ? 'Správne!' : 'Zatiaľ nesprávne.');
      }

      checkSingleBtn.addEventListener('click', checkCurrentQuestionImmediately);

      flagQuestionBtn.addEventListener('click', () => {
        const q = questions[currentIndex];
        flaggedQuestions[q.id] = !flaggedQuestions[q.id];
        playSound('click');
        saveStateToStorage();
        renderQuestion();
      });

      prevQuestionBtn.addEventListener('click', () => {
        playSound('click');
        if (isEvaluated && filterWrongOnly) {
          const wrongs = getWrongQuestionIndices();
          const prevW = [...wrongs].reverse().find((i) => i < currentIndex);
          if (prevW !== undefined) goToQuestion(prevW);
          return;
        }
        if (currentIndex > 0) goToQuestion(currentIndex - 1);
      });

      nextQuestionBtn.addEventListener('click', () => {
        if (isEvaluated && filterWrongOnly) {
          playSound('click');
          const wrongs = getWrongQuestionIndices();
          const nextW = wrongs.find((i) => i > currentIndex);
          if (nextW !== undefined) goToQuestion(nextW);
          return;
        }
        if (currentIndex < LAST_INDEX) {
          playSound('click');
          goToQuestion(currentIndex + 1);
        } else if (!isEvaluated) {
          evaluateTest(false);
        }
      });

      // Výsledky, témy a tlač do PDF
      function getSpentSeconds() {
        return mode === 'practice' ? elapsedSeconds : INITIAL_SECONDS - remainingSeconds;
      }

      function renderResultsBreakdownAndPrintReport() {
        let correctCount = 0;
        questions.forEach((q) => {
          if (isQuestionCorrect(q, userAnswers[q.id])) correctCount++;
        });

        const wrongCount = questions.length - correctCount;
        const pctNum = (correctCount / questions.length) * 100;
        const pct = pctNum.toFixed(1).replace('.', ',');
        const spentMin = Math.max(1, Math.round(getSpentSeconds() / 60));
        const scoreLevel = pctNum >= 75 ? 'good' : pctNum >= 50 ? 'mid' : 'low';
        const modeLabel = mode === 'exam' ? 'Ostrý test' : 'Precvičovanie';

        resultsEyebrow.textContent = `Výsledok testu · ${modeLabel}`;
        document.getElementById('timeUpNote').classList.toggle('hidden', !(mode === 'exam' && remainingSeconds <= 0));
        const emptyCount = questions.filter((q) => String(userAnswers[q.id] ?? '').trim() === '').length;
        scorePercent.textContent = `${pct} %`;
        statCorrectCount.textContent = String(correctCount);
        statWrongCount.textContent = String(wrongCount);
        const emptyWord = emptyCount === 1 ? 'nevyplnená' : emptyCount <= 4 ? 'nevyplnené' : 'nevyplnených';
        document.getElementById('statWrongLabel').textContent = emptyCount > 0 ? `nesprávne, z toho ${emptyCount} ${emptyWord}` : 'nesprávne';
        statTimeSpent.textContent = `${spentMin} min`;

        // Kruh sa pri novom výsledku plynulo naplní a body sa napočítajú (pri prepínaní filtra už nie)
        const ringLen = 2 * Math.PI * 68;
        const ringTarget = ringLen * (1 - pctNum / 100);
        const shownKey = `${correctCount}/${questions.length}`;
        const animate = scoreRing.dataset.shown !== shownKey && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        scoreRing.dataset.shown = shownKey;
        scoreRingFill.style.strokeDasharray = `${ringLen}`;
        scoreRing.classList.remove('good', 'mid', 'low');
        scoreRing.classList.add(scoreLevel);
        if (animate) {
          scoreRingFill.style.transition = 'none';
          scoreRingFill.style.strokeDashoffset = `${ringLen}`;
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              scoreRingFill.style.transition = '';
              scoreRingFill.style.strokeDashoffset = `${ringTarget}`;
            })
          );
          const t0 = performance.now();
          const step = (now) => {
            const k = Math.min(1, (now - t0) / 1100);
            const eased = 1 - Math.pow(1 - k, 3);
            scorePoints.textContent = `${Math.round(correctCount * eased)}/${questions.length}`;
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
          // Poistka: ak prehliadač snímky spomalí (karta na pozadí), konečný stav sa nastaví aj tak
          setTimeout(() => {
            scorePoints.textContent = shownKey;
            scoreRingFill.style.transition = '';
            scoreRingFill.style.strokeDashoffset = `${ringTarget}`;
          }, 1250);
        } else {
          scoreRingFill.style.strokeDashoffset = `${ringTarget}`;
          scorePoints.textContent = shownKey;
        }

        const scoreLead = document.getElementById('scoreLead');
        if (pctNum >= 90) {
          scoreTitle.textContent = 'Vynikajúci výsledok!';
          scoreLead.textContent = 'Takmer bez chyby. S takouto prípravou môžeš ísť na Testovanie 9 pokojne.';
        } else if (pctNum >= 75) {
          scoreTitle.textContent = 'Veľmi pekný výsledok!';
          scoreLead.textContent = 'Väčšinu úloh zvládaš. Prejdi si zvyšné chyby s postupom riešenia a máš to.';
        } else if (pctNum >= 50) {
          scoreTitle.textContent = 'Dobrý základ – pozri si chyby';
          scoreLead.textContent = 'Polovicu bodov už máš. Najviac získaš, keď si chybné úlohy prejdeš s postupom riešenia.';
        } else {
          scoreTitle.textContent = 'Nevadí! Pozri si postupy a vysvetlenia';
          scoreLead.textContent = 'Každá chyba ti ukáže, čo si zopakovať. Otvor si chybné úlohy a prečítaj si postup krok za krokom.';
        }

        if (wrongCount === 0) {
          toggleWrongOnlyBtn.disabled = true;
          toggleWrongOnlyBtn.classList.remove('is-active');
          toggleWrongOnlyBtn.innerHTML = `${UI.trophy}<span>Žiadna chyba!</span>`;
        } else {
          toggleWrongOnlyBtn.disabled = false;
          toggleWrongOnlyBtn.classList.toggle('is-active', filterWrongOnly);
          toggleWrongOnlyBtn.innerHTML = filterWrongOnly
            ? `${UI.grid}<span>Zobraziť všetky úlohy (${questions.length})</span>`
            : `${UI.target}<span>Prejsť len chybné úlohy (${wrongCount})</span>`;
        }

        const topicStats = TOPIC_GROUPS.map((grp) => {
          const grpQuestions = grp.questionIds.map((id) => questions.find((q) => q.id === id)).filter(Boolean);
          let grpCorrect = 0;
          grpQuestions.forEach((q) => {
            if (isQuestionCorrect(q, userAnswers[q.id])) grpCorrect++;
          });
          const grpTotal = grpQuestions.length;
          const grpPctNum = grpTotal > 0 ? (grpCorrect / grpTotal) * 100 : 0;
          const grpPctStr = grpPctNum.toFixed(1).replace('.', ',');
          const level = grpPctNum >= 75 ? 'good' : grpPctNum >= 50 ? 'mid' : 'low';
          return { ...grp, grpQuestions, grpCorrect, grpTotal, grpPctNum, grpPctStr, level };
        });

        // Najsilnejšia oblasť a oblasť na zopakovanie (len ak sa líšia)
        const sortedTopics = [...topicStats].sort((a, b) => b.grpPctNum - a.grpPctNum);
        const bestTopic = sortedTopics[0];
        const weakTopic = sortedTopics[sortedTopics.length - 1];
        const showBadges = topicStats.length > 1 && bestTopic.grpPctNum > weakTopic.grpPctNum;

        // Mapa odpovedí podľa častí testu (ukážky a jazyková časť)
        document.getElementById('answerMap').innerHTML = (testData.stepperGroups || [])
          .map((grp) => {
            const cells = questions
              .slice(grp.fromIndex, grp.toIndex + 1)
              .map((q, i) => {
                const idx = grp.fromIndex + i;
                const raw = userAnswers[q.id];
                const empty = String(raw ?? '').trim() === '';
                const ok = !empty && isQuestionCorrect(q, raw);
                const cls = ok ? 'is-ok' : empty ? 'is-empty' : 'is-err';
                const state = ok ? 'správne' : empty ? 'nevyplnená' : 'chyba';
                return `<button type="button" class="tp-map-cell ${cls}" data-jump-idx="${idx}" title="Úloha ${q.code} – ${state}" aria-label="Úloha ${q.code} – ${state}">${q.code}</button>`;
              })
              .join('');
            return `<div class="tp-map-group"><span class="tp-map-label">${escHtml(grp.label)}</span><div class="tp-map-cells">${cells}</div></div>`;
          })
          .join('');
        const jumpFromResults = (jumpIdx) => {
          playSound('click');
          const targetQ = questions[jumpIdx];
          if (filterWrongOnly && targetQ && isQuestionCorrect(targetQ, userAnswers[targetQ.id])) {
            filterWrongOnly = false;
            renderResultsBreakdownAndPrintReport();
          }
          goToQuestion(jumpIdx);
          workspace.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        document.querySelectorAll('#answerMap [data-jump-idx]').forEach((btn) => {
          btn.addEventListener('click', () => jumpFromResults(Number(btn.getAttribute('data-jump-idx'))));
        });

        topicsBreakdownGrid.innerHTML = topicStats
          .map((st) => {
            const badge = !showBadges
              ? ''
              : st.id === bestTopic.id
                ? '<span class="tp-topic-badge is-best">Najsilnejšia oblasť</span>'
                : st.id === weakTopic.id
                  ? '<span class="tp-topic-badge is-weak">Na zopakovanie</span>'
                  : '';
            const pillsHtml = st.grpQuestions
              .map((q) => {
                const ok = isQuestionCorrect(q, userAnswers[q.id]);
                const qIdx = questions.findIndex((item) => item.id === q.id);
                return `<button type="button" class="tp-mini ${ok ? 'is-ok' : 'is-err'}" data-jump-idx="${qIdx}" title="Prejsť na úlohu ${q.code}">${q.code}</button>`;
              })
              .join('');

            return `
              <div class="tp-topic ${st.level}">
                <div class="tp-topic-top">
                  <span class="tp-topic-ico">${UI['topic_' + st.id] || UI.grid}</span>
                  <span class="tp-topic-name">${st.name}</span>
                  ${badge}
                </div>
                <div class="tp-topic-score">
                  <strong>${st.grpCorrect}<small>/${st.grpTotal}</small></strong>
                  <span>${st.grpPctStr} %</span>
                </div>
                <div class="tp-topic-track"><span style="width: ${Math.round(st.grpPctNum)}%;"></span></div>
                <div class="tp-topic-minis">${pillsHtml}</div>
              </div>
            `;
          })
          .join('');

        topicsBreakdownGrid.querySelectorAll('[data-jump-idx]').forEach((btn) => {
          btn.addEventListener('click', () => jumpFromResults(Number(btn.getAttribute('data-jump-idx'))));
        });

        const dateStr = new Date().toLocaleDateString('sk-SK', {
          day: '2-digit',
          month: '2-digit',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });

        const buildQuestionsRows = (sliceQuestions) =>
          sliceQuestions
            .map((q) => {
              const rawAns = userAnswers[q.id];
              const userDisp = rawAns && String(rawAns).trim() !== '' ? escHtml(rawAns) : '—';
              const ok = isQuestionCorrect(q, rawAns);
              return `
                <tr>
                  <td><strong>${q.code}</strong></td>
                  <td>${escHtml(q.category)}</td>
                  <td><strong>${userDisp}</strong></td>
                  <td>${escHtml(q.correctAnswerDisplay)}</td>
                  <td style="font-weight:700;color:${ok ? '#237c40' : '#bc3233'};">${ok ? '✔ 1 b' : '✖ 0 b'}</td>
                </tr>
              `;
            })
            .join('');

        const half = Math.ceil(questions.length / 2);
        printableReport.innerHTML = `
          <div class="print-header-box">
            <div>
              <h1>VÝSLEDKOVÝ LIST – TESTOVANIE 9 (SLOVENSKÝ JAZYK A LITERATÚRA ${testYear})</h1>
              <p>Riadny termín (šk. rok ${testSchoolYear}) • ${testVariant} (kód ${testCode}) • Režim: ${modeLabel.toLowerCase()} • Úlohy a kľúč odpovedí © NIVaM</p>
            </div>
            <div style="text-align:right;">
              <p><strong>Meno žiaka:</strong> ${studentName ? escHtml(studentName) : '______________________'}</p>
              <p><strong>Dátum vyhodnotenia:</strong> ${dateStr}</p>
            </div>
          </div>

          <div class="print-summary-grid">
            <div class="print-summary-cell">
              <small>Získané body</small>
              <strong>${correctCount} / ${questions.length} bodov</strong>
            </div>
            <div class="print-summary-cell">
              <small>Percentuálna úspešnosť</small>
              <strong>${pct} %</strong>
            </div>
            <div class="print-summary-cell">
              <small>Správne / Nesprávne</small>
              <strong>${correctCount} ✔ / ${wrongCount} ✖</strong>
            </div>
            <div class="print-summary-cell">
              <small>Čas riešenia</small>
              <strong>${spentMin} min${mode === 'exam' ? ` (z ${testMeta.durationMinutes} min)` : ''}</strong>
            </div>
          </div>

          <h3 style="margin:0 0 0.35rem 0;font-size:10.5pt;">Prehľad podľa oblastí SJL</h3>
          <table class="print-topics-table">
            <thead>
              <tr>
                <th>Oblasť SJL</th>
                <th>Úlohy v teste</th>
                <th>Získané body</th>
                <th>Úspešnosť</th>
              </tr>
            </thead>
            <tbody>
              ${topicStats
                .map(
                  (st) => `
                <tr>
                  <td><strong>${escHtml(st.name)}</strong></td>
                  <td>${st.grpQuestions.map((q) => q.code).join(', ')}</td>
                  <td><strong>${st.grpCorrect} / ${st.grpTotal}</strong></td>
                  <td><strong>${st.grpPctStr} %</strong></td>
                </tr>
              `
                )
                .join('')}
            </tbody>
          </table>

          <h3 style="margin:0 0 0.35rem 0;font-size:10.5pt;">Podrobný prehľad odpovedí (úlohy 01 – ${questions.length})</h3>
          <div class="print-two-col-tables">
            <table class="print-questions-table">
              <thead>
                <tr>
                  <th>Úl.</th>
                  <th>Téma</th>
                  <th>Žiak</th>
                  <th>Kľúč</th>
                  <th>Body</th>
                </tr>
              </thead>
              <tbody>${buildQuestionsRows(questions.slice(0, half))}</tbody>
            </table>

            <table class="print-questions-table">
              <thead>
                <tr>
                  <th>Úl.</th>
                  <th>Téma</th>
                  <th>Žiak</th>
                  <th>Kľúč</th>
                  <th>Body</th>
                </tr>
              </thead>
              <tbody>${buildQuestionsRows(questions.slice(half))}</tbody>
            </table>
          </div>

          <p style="margin:0.55rem 0 0;font-size:8pt;color:#475569;">
            Nositeľom autorských práv k úlohám Testovania 9 (${testYear}) a kľúču správnych odpovedí je Národný inštitút vzdelávania a mládeže (NIVaM).
            Texty a grafické objekty boli prepisované a graficky upravované – NIVaM nezodpovedá za chyby vzniknuté z tohto dôvodu.
            Postupy riešenia a nápovedy nie sú autorským dielom NIVaM a NIVaM nezodpovedá za ich obsah.
          </p>
        `;

        return pctNum;
      }

      // Potvrdzovací dialóg
      let pendingConfirmAction = null;

      function openConfirm({ eyebrow, title, html, proceedLabel, onProceed }) {
        confirmEyebrow.textContent = eyebrow;
        confirmTitle.textContent = title;
        confirmBody.innerHTML = html;
        confirmProceedBtn.textContent = proceedLabel;
        pendingConfirmAction = onProceed;
        openModal(confirmModal);
      }

      confirmCancelBtn.addEventListener('click', () => {
        closeModal(confirmModal);
        pendingConfirmAction = null;
      });

      confirmProceedBtn.addEventListener('click', () => {
        const fn = pendingConfirmAction;
        pendingConfirmAction = null;
        closeModal(confirmModal);
        if (typeof fn === 'function') fn();
      });

      function buildReviewHtml() {
        const unanswered = [];
        const flagged = [];
        questions.forEach((q, idx) => {
          if (!hasAnswer(q)) unanswered.push({ q, idx });
          if (flaggedQuestions[q.id]) flagged.push({ q, idx });
        });
        const answered = questions.length - unanswered.length;
        const ansPart = answered === 1 ? 'vyplnenú' : answered >= 2 && answered <= 4 ? 'vyplnené' : 'vyplnených';
        const hasChips = unanswered.length > 0 || flagged.length > 0;
        const chips = (list, cls) =>
          list
            .map(
              (item) =>
                `<button type="button" class="tp-review-chip ${cls}" data-review-jump="${item.idx}" aria-label="Úloha ${item.q.code}">${item.q.code}</button>`
            )
            .join('');

        return `
          <p class="tp-confirm-lead">Máš ${ansPart} <strong>${answered} z ${questions.length}</strong> úloh.</p>
          ${
            unanswered.length > 0
              ? `<p class="tp-confirm-lead">Nevyplnené úlohy (${unanswered.length}):</p><div class="tp-review-chips">${chips(unanswered, '')}</div>`
              : ''
          }
          ${
            flagged.length > 0
              ? `<p class="tp-confirm-lead">Označené úlohy na kontrolu (${flagged.length}):</p><div class="tp-review-chips">${chips(flagged, 'is-flag')}</div>`
              : ''
          }
          <p style="margin:0;font-size:0.86rem;color:var(--tp-ink-3);">${
            hasChips
              ? 'Kliknutím na číslo úlohy sa k nej vrátiš, alebo potvrď vyhodnotenie testu.'
              : 'Všetky úlohy máš vyplnené. Potvrď odovzdanie a vyhodnotenie testu.'
          }</p>
        `;
      }

      function finalizeEvaluation() {
        isEvaluated = true;
        stopTimer();
        playSound('finish');
        const pctNum = renderResultsBreakdownAndPrintReport();
        resultsDashboard.classList.remove('hidden');
        updateModeUI();
        renderQuestion();
        saveStateToStorage();

        let correctCount = 0;
        questions.forEach((q) => {
          if (isQuestionCorrect(q, userAnswers[q.id])) correctCount++;
        });
        safeStorageSet(LAST_KEY, JSON.stringify({ correct: correctCount, total: questions.length, savedAt: Date.now() }));
        safeStorageSet(
          RESULT_KEY,
          JSON.stringify({
            mode,
            userAnswers,
            singleCheckedState,
            flaggedQuestions,
            studentName,
            remainingSeconds,
            elapsedSeconds,
            correct: correctCount,
            total: questions.length,
            savedAt: Date.now()
          })
        );

        resultsDashboard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        if (pctNum >= 75) launchConfetti();
      }

      function evaluateTest(autoTimeUp = false) {
        if (isEvaluated) {
          resultsDashboard.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }
        if (autoTimeUp) {
          finalizeEvaluation();
          return;
        }
        openConfirm({
          eyebrow: 'Vyhodnotenie testu',
          title: 'Odovzdať a vyhodnotiť test?',
          html: buildReviewHtml(),
          proceedLabel: 'Vyhodnotiť test',
          onProceed: finalizeEvaluation
        });
        confirmBody.querySelectorAll('[data-review-jump]').forEach((btn) => {
          btn.addEventListener('click', () => {
            closeModal(confirmModal);
            goToQuestion(Number(btn.getAttribute('data-review-jump')));
          });
        });
      }

      evaluateTestBtn.addEventListener('click', () => evaluateTest(false));

      toggleWrongOnlyBtn.addEventListener('click', () => {
        playSound('click');
        filterWrongOnly = !filterWrongOnly;
        if (filterWrongOnly) {
          const wrongs = getWrongQuestionIndices();
          if (wrongs.length > 0 && isQuestionCorrect(questions[currentIndex], userAnswers[questions[currentIndex].id])) {
            currentIndex = wrongs[0];
          }
        }
        renderResultsBreakdownAndPrintReport();
        renderQuestion();
        saveStateToStorage();
        if (filterWrongOnly) {
          requestAnimationFrame(() => wrongModeBanner.scrollIntoView({ behavior: 'smooth', block: 'start' }));
        }
      });

      exitWrongModeBtn.addEventListener('click', () => {
        playSound('click');
        filterWrongOnly = false;
        renderResultsBreakdownAndPrintReport();
        renderQuestion();
        saveStateToStorage();
      });

      retryTestBtn.addEventListener('click', () => {
        // Z archivovaného výsledku sa ide na úvod testu, kde sa dá pokračovať v rozpracovanom pokuse alebo začať nový
        if (viewingArchive) {
          window.location.href = window.location.pathname;
          return;
        }
        openConfirm({
          eyebrow: 'Nový pokus',
          title: 'Skúsiť test odznova?',
          html: '<p class="tp-confirm-lead">Vymazať aktuálne odpovede a začať tento test od začiatku?</p>',
          proceedLabel: 'Áno, začať odznova',
          onProceed: () => {
            resetAnswers();
            enterWorkspace(mode || 'practice', false);
          }
        });
      });

      studentNameInput.addEventListener('input', () => {
        studentName = studentNameInput.value;
        saveStateToStorage();
        if (isEvaluated) renderResultsBreakdownAndPrintReport();
      });

      printReportBtn.addEventListener('click', () => {
        playSound('click');
        renderResultsBreakdownAndPrintReport();
        window.print();
      });

      // Modálne okná (Nápoveda, Postup riešenia)
      let lastFocused = null;
      function openModal(modal) {
        lastFocused = document.activeElement;
        modal.classList.remove('hidden');
        const closeBtn = modal.querySelector('.modal-close-btn');
        if (closeBtn) closeBtn.focus();
      }

      function closeModal(modal) {
        modal.classList.add('hidden');
        if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      }

      document.querySelectorAll('[data-close-modal]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-close-modal');
          const m = document.getElementById(id);
          if (m) closeModal(m);
        });
      });

      [hintModal, solutionModal, confirmModal].forEach((m) => {
        m.addEventListener('click', (e) => {
          if (e.target === m) closeModal(m);
        });
      });

      function showHintForCurrentQuestion() {
        if (isExamLocked()) return;
        playSound('click');
        const q = questions[currentIndex];
        hintModalTitle.textContent = `Úloha ${q.code}`;
        hintModalContent.textContent = q.hint;
        bindSlovakTypography(hintModalContent);
        openModal(hintModal);
      }

      function showSolutionForCurrentQuestion() {
        if (isExamLocked()) return;
        playSound('click');
        const q = questions[currentIndex];
        solutionModalTitle.textContent = `Úloha ${q.code}`;
        solutionStepsList.innerHTML = q.solutionSteps
          .map(
            (s, idx) => `
            <li class="tp-step">
              <span class="tp-step-num">${idx + 1}</span>
              <div class="tp-step-body">
                <h4>${escHtml(s.title)}</h4>
                <p>${formatQuestionText(s.text)}</p>
              </div>
            </li>
          `
          )
          .join('');
        solutionConclusionBox.innerHTML = `${UI.checkCircle}<div><strong>Záver:</strong> ${inlineMarks(q.solutionConclusion)}</div>`;
        bindSlovakTypography(solutionModal);
        openModal(solutionModal);
      }

      openHintBtn.addEventListener('click', showHintForCurrentQuestion);
      openSolutionBtn.addEventListener('click', showSolutionForCurrentQuestion);
      evalOpenSolutionBtn.addEventListener('click', showSolutionForCurrentQuestion);
      switchHintToSolutionBtn.addEventListener('click', () => {
        closeModal(hintModal);
        showSolutionForCurrentQuestion();
      });

      // Nahlásenie chyby e-mailom
      const REPORT_PARTS = {
        question: 'zadanie alebo správna odpoveď úlohy',
        hint: 'nápoveda',
        solution: 'postup riešenia'
      };

      function openReport(part) {
        playSound('click');
        const q = questions[currentIndex];
        const detail = REPORT_PARTS[part] || REPORT_PARTS.question;
        const subject = `Testovanie 9 SJL – ${testYear}: úloha ${q.code} – nahlásenie chyby`;
        const body = [
          'Dobrý deň,',
          '',
          `chcem nahlásiť chybu v teste Testovanie 9 – ${testYear} (slovenský jazyk a literatúra).`,
          '',
          `Úloha: ${q.code} (${q.category})`,
          `Časť: ${detail}`,
          `Odkaz: ${canonicalUrl}`,
          '',
          'Popis chyby:',
          '',
          ''
        ].join('\n');
        window.location.href = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      }

      document.getElementById('reportQuestionBtn').addEventListener('click', () => openReport('question'));
      document.querySelectorAll('[data-report]').forEach((btn) => {
        btn.addEventListener('click', () => openReport(btn.getAttribute('data-report')));
      });

      // Klávesové skratky
      const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

      document.addEventListener('keydown', (e) => {
        const installAppModal = document.getElementById('installAppModal');
        const topDialog =
          [confirmModal, solutionModal, hintModal, installAppModal].find((m) => m && !m.classList.contains('hidden')) ||
          (!zoomModal.classList.contains('hidden') ? zoomModal : null);

        if (e.key === 'Escape' && topDialog) {
          if (topDialog === installAppModal) return;
          if (topDialog === zoomModal) closeZoom();
          else closeModal(topDialog);
          return;
        }

        if (e.key === 'Tab' && topDialog) {
          const items = Array.from(topDialog.querySelectorAll(FOCUSABLE)).filter((el) => el.offsetParent !== null);
          if (items.length > 0) {
            const first = items[0];
            const last = items[items.length - 1];
            if (!topDialog.contains(document.activeElement)) {
              e.preventDefault();
              first.focus();
            } else if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
          return;
        }

        if (topDialog || !mode || document.body.classList.contains('tp-intro-active') || e.altKey || e.ctrlKey || e.metaKey) return;

        const tgt = e.target;
        if (tgt && tgt.closest('input, textarea, select, [contenteditable="true"]')) return;

        const q = questions[currentIndex];
        if (e.key === 'ArrowRight') {
          if (!nextQuestionBtn.disabled && !(currentIndex === LAST_INDEX && !isEvaluated)) {
            e.preventDefault();
            nextQuestionBtn.click();
          }
        } else if (e.key === 'ArrowLeft') {
          if (!prevQuestionBtn.disabled) {
            e.preventDefault();
            prevQuestionBtn.click();
          }
        } else if (/^[abcd]$/i.test(e.key) && q.type === 'choice' && !isEvaluated) {
          e.preventDefault();
          selectChoice(e.key.toUpperCase());
        } else if (e.key === 'Enter' && q.type === 'choice' && !(tgt && tgt.closest('button, a'))) {
          if (!isExamLocked() && !isEvaluated) {
            e.preventDefault();
            checkCurrentQuestionImmediately();
          } else if (isExamLocked() && currentIndex < LAST_INDEX) {
            e.preventDefault();
            nextQuestionBtn.click();
          }
        }
      });

      // Konfety pri >= 75 %
      function launchConfetti() {
        const canvas = document.getElementById('confettiCanvas');
        if (!canvas || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        const colors = [ACCENT.base, ACCENT.soft, '#007974', '#f59e0b', '#fef08a', '#2563eb'];
        const pieces = Array.from({ length: 85 }, () => ({
          x: Math.random() * canvas.width,
          y: -20 - Math.random() * canvas.height * 0.4,
          w: 6 + Math.random() * 6,
          h: 4 + Math.random() * 6,
          vx: (Math.random() - 0.5) * 4,
          vy: 2.5 + Math.random() * 3.5,
          rot: Math.random() * Math.PI * 2,
          vr: (Math.random() - 0.5) * 0.2,
          color: colors[Math.floor(Math.random() * colors.length)]
        }));

        let frames = 0;
        function tick() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          pieces.forEach((p) => {
            p.x += p.vx;
            p.y += p.vy;
            p.rot += p.vr;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rot);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
            ctx.restore();
          });
          frames++;
          if (frames < 150) requestAnimationFrame(tick);
          else ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
        requestAnimationFrame(tick);
      }

      // Výška prilepenej hlavičky pre prilepenú ukážku (mení sa pri zalomení a zväčšení písma)
      const headerEl = document.querySelector('.tp-header');
      const syncHeaderHeight = () => document.documentElement.style.setProperty('--tp-header-h', headerEl.offsetHeight + 'px');
      syncHeaderHeight();
      if (typeof ResizeObserver !== 'undefined') new ResizeObserver(syncHeaderHeight).observe(headerEl);

      // Na mobile je prehľad úloh predvolene zbalený, aby bolo úlohu vidno hneď
      if (window.matchMedia('(max-width: 720px)').matches) {
        stepperCard.classList.add('is-collapsed');
        stepperToggleBtn.setAttribute('aria-expanded', 'false');
      }

      // Priamy odkaz na výsledok (#vysledok) z karty ročníka na úvodnej stránke
      function openResultFromHash() {
        if (window.location.hash !== '#vysledok') return;
        const saved = loadStateFromStorage();
        if (saved && saved.mode && saved.isEvaluated) {
          document.getElementById('resumeSavedBtn').click();
          resultsDashboard.scrollIntoView({ block: 'start' });
          return;
        }
        let snap = null;
        try {
          snap = JSON.parse(safeStorageGet(RESULT_KEY) || 'null');
        } catch (e) {}
        if (!snap || !snap.mode) return;
        viewingArchive = true;
        clearAnswerObjects();
        Object.assign(userAnswers, snap.userAnswers || {});
        Object.assign(singleCheckedState, snap.singleCheckedState || {});
        Object.assign(flaggedQuestions, snap.flaggedQuestions || {});
        isEvaluated = true;
        filterWrongOnly = false;
        studentName = snap.studentName || '';
        studentNameInput.value = studentName;
        currentIndex = 0;
        remainingSeconds = typeof snap.remainingSeconds === 'number' ? snap.remainingSeconds : INITIAL_SECONDS;
        elapsedSeconds = typeof snap.elapsedSeconds === 'number' ? snap.elapsedSeconds : 0;
        enterWorkspace(snap.mode, true);

        const note = document.getElementById('archiveNote');
        const when = new Date(snap.savedAt || Date.now()).toLocaleDateString('sk-SK', { day: 'numeric', month: 'numeric', year: 'numeric' });
        const filled = saved && saved.userAnswers ? Object.values(saved.userAnswers).filter((v) => String(v).trim() !== '').length : 0;
        document.getElementById('archiveNoteText').innerHTML =
          `Prezeráš posledný vyhodnotený pokus z&nbsp;${when}.` + (saved && saved.mode ? ` Nový pokus máš rozpracovaný (${filled}/${questions.length}).` : '');
        document.getElementById('archiveBackBtn').classList.toggle('hidden', !(saved && saved.mode));
        note.classList.remove('hidden');
        resultsDashboard.scrollIntoView({ block: 'start' });
      }

      document.getElementById('archiveBackBtn').addEventListener('click', () => {
        window.location.href = window.location.pathname;
      });

      // Inicializácia
      window.addEventListener('hashchange', openResultFromHash);
      refreshIntroResumeBox();
      openResultFromHash();
    </script>
  </body>
</html>
