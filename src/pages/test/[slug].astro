      const STORAGE_KEY = 'monitorsjl_test_' + testSlug + '_v1';
      const LAST_KEY = 'monitorsjl_last_' + testSlug + '_v1';
      // Posledný vyhodnotený pokus – nový pokus ho neprepíše, úvodná stránka naň odkazuje (#vysledok)
      const RESULT_KEY = 'monitorsjl_result_' + testSlug + '_v1';
