---
import '../../styles/fonts.css';
import '../../styles/global.css';
import '../../styles/test.css';
import { testsCatalog } from '../../data/testsCatalog';
import { testsDataBySlug } from '../../data/tests';
import SiteFooter from '../../components/SiteFooter.astro';
import SeoHead from '../../components/SeoHead.astro';
import { SITE_URL, CONTACT_EMAIL, NIVAM_URL } from '../../lib/site';
import { I, icon } from '../../lib/icons';
import { ACCENTS } from '../../lib/accents';

export function getStaticPaths() {
  return testsCatalog
    .filter((t) => t.status === 'ready')
    .map((testItem) => ({
      params: { slug: testItem.slug },
      props: { testItem }
    }));
}

const { testItem } = Astro.props;
const activeModule = testsDataBySlug[testItem.slug];
const accent = ACCENTS[testItem.accent];

if (!activeModule) {
  throw new Error(`Chýba testový modul pre slug: ${testItem.slug}`);
}

const canonicalUrl = `${SITE_URL}/test/${testItem.slug}/`;
const initialTimerDisplay = `${String(testItem.durationMinutes).padStart(2, '0')}:00`;

const testData = {
  questions: activeModule.questions,
  passages: activeModule.passages,
  diagrams: activeModule.diagrams,
  stepperGroups: activeModule.stepperGroups,
  topicGroups: activeModule.topicGroups
};

const testMeta = {
  slug: testItem.slug,
  year: testItem.year,
  schoolYear: testItem.schoolYear,
  variant: testItem.variant,
  code: testItem.code,
  durationMinutes: testItem.durationMinutes,
  canonicalUrl,
  CONTACT_EMAIL
};

const UI = {
  checkCircle: icon(I.checkCircle),
  xCircle: icon(I.xCircle),
  alert: icon(I.alert),
  arrow: icon(I.arrow),
  flag: icon(I.flag),
  lock: icon(I.lock),
  grid: icon(I.grid),
  target: icon(I.target),
  trophy: icon(I.trophy),
  play: icon(I.play),
  pause: icon(I.pause),
  volume: icon(I.volume),
  mute: icon(I.mute),
  topic_porozumenie: icon(I.book),
  topic_pravopis_lexika: icon(I.spellcheck),
  topic_tvaroslovie: icon(I.feather),
  topic_skladba_literatura: icon(I.quote)
};

const variantLower = testItem.variant.replace(/^V/, 'v');
const pageTitle = `${testItem.title} zo slovenčiny online s riešením`;
const pageDescription = `Testovanie 9 zo slovenčiny ${testItem.year} (${variantLower}, kód ${testItem.code}) online: ${testItem.questionsCount} úloh s ukážkami, kľúčom odpovedí, nápovedou a postupom riešenia. Zadarmo.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LearningResource', 'Quiz'],
      name: `${testItem.title} – ${testItem.subtitle}`,
      description: pageDescription,
      inLanguage: 'sk',
      educationalLevel: '9. ročník ZŠ',
      learningResourceType: 'Test',
      about: 'Slovenský jazyk a literatúra',
      url: canonicalUrl,
      timeRequired: `PT${testItem.durationMinutes}M`,
      isAccessibleForFree: true,
      copyrightHolder: { '@type': 'Organization', name: 'Národný inštitút vzdelávania a mládeže (NIVaM)', url: NIVAM_URL },
      copyrightYear: testItem.year,
      isPartOf: { '@id': `${SITE_URL}/#website` }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Testovanie 9 zo slovenčiny', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: testItem.title, item: canonicalUrl }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="sk">
  <head>
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      path={`/test/${testItem.slug}/`}
      themeColor={accent.base}
      jsonLd={jsonLd}
    />
  </head>
  <body class={`tp-page tp-dyslexic tp-intro-active acc-${testItem.accent}`}>
    <a class="skip-link" href="#hlavna-uloha">Preskočiť na úlohu</a>
    <div id="liveRegion" class="sr-only" aria-live="polite"></div>

    <header class="tp-header">
      <div class="tp-header-in">
        <div class="tp-hleft">
          <a class="tp-back" href="/" aria-label="Späť na úvodnú stránku" title="Späť na úvodnú stránku">
            <Fragment set:html={icon(I.arrowLeft)} />
          </a>
          <span class="brand-mark tp-hmark" aria-hidden="true">T9</span>
          <div class="tp-htitle">
            <div class="tp-htitle-row">
              <h1 aria-label={`${testItem.title} · Slovenčina`}><span class="tp-h1-long">{testItem.title}</span><span class="tp-h1-short">T9&nbsp;{testItem.year}</span><span class="tp-h1-subj"> · Slovenčina</span></h1>
              <span class="tp-mode-chip" id="modeChip">Režim</span>
            </div>
            <span class="tp-hmeta">Šk.&nbsp;rok {testItem.schoolYear} · {testItem.variant} (kód&nbsp;{testItem.code}) · ©&nbsp;NIVaM</span>
          </div>
        </div>

        <div class="tp-hright">
          <div class="tp-prog-pill" aria-label="Postup vyplnenia">
            <span id="progressText">0/{testItem.questionsCount}</span>
            <span class="tp-prog-track"><span class="tp-prog-fill" id="headerProgressFill"></span></span>
          </div>

          <div class="tp-timer" id="timerWidget">
            <Fragment set:html={icon(I.clock)} />
            <span class="tp-timer-val" id="timerDisplay">{initialTimerDisplay}</span>
            <button class="tp-ico-btn" type="button" id="timerToggleBtn" title="Pozastaviť / spustiť časovač" aria-label="Pozastaviť alebo spustiť časovač">
              <Fragment set:html={icon(I.pause)} />
            </button>
            <button class="tp-ico-btn" type="button" id="timerResetBtn" title="Resetovať čas" aria-label="Resetovať časovač">
              <Fragment set:html={icon(I.rotate)} />
            </button>
          </div>

          <button class="tp-hbtn tp-eval-btn" type="button" id="evaluateTestBtn">
            <Fragment set:html={icon(I.checkCircle)} />
            <span class="tp-eval-label" id="evaluateBtnLabel">Vyhodnotiť test</span>
            <span class="tp-eval-short" id="evaluateBtnShort" aria-hidden="true">Vyhodnotiť</span>
          </button>
        </div>
      </div>
    </header>

    <div class="tp-subbar no-print">
        <div class="tp-subbar-in">
          <div class="tp-a11y-tools">
            <button class="tp-chip-btn" type="button" id="soundToggleBtn" aria-pressed="true" data-sfx="none">
              <span id="soundToggleIco"><Fragment set:html={icon(I.volume)} /></span>
              <span id="soundToggleText">Zvuky: zap.</span>
            </button>
            <button class="tp-chip-btn" type="button" id="changeModeBtn" title="Vrátiť sa na výber režimu">
              <Fragment set:html={icon(I.rotate)} />
              <span>Zmeniť režim</span>
            </button>
            <button class="tp-chip-btn" type="button" data-install="any" title="Pridať aplikáciu na plochu">
              <Fragment set:html={icon(I.appAdd)} />
              <span>Pridať na plochu</span>
            </button>
            <button class="tp-chip-btn" type="button" data-share title="Zdieľať odkaz na tento test">
              <Fragment set:html={icon(I.share)} />
              <span data-share-label>Zdieľať</span>
            </button>
          </div>
        </div>
    </div>

    <main class="tp-main" id="hlavna-uloha">
      <!-- Úvodná voľba režimu -->
      <section class="tp-intro" id="introScreen">
        <div class="tp-intro-head">
          <h2>Ako chceš dnes trénovať?</h2>
          <p>Vyber si režim. Odpovede sa ti priebežne ukladajú v&nbsp;tomto prehliadači, takže sa môžeš kedykoľvek vrátiť.</p>
        </div>

        <ul class="tp-facts">
          <li>
            <span class="tp-facts-ico"><Fragment set:html={icon(I.file)} /></span>
            <span><strong>{testItem.questionsCount} úloh</strong><small>{testItem.choiceCount} s výberom A – D, {testItem.openCount} s krátkou odpoveďou</small></span>
          </li>
          <li>
            <span class="tp-facts-ico"><Fragment set:html={icon(I.clock)} /></span>
            <span><strong>{testItem.durationMinutes} minút</strong><small>ako na skutočnom teste</small></span>
          </li>
          <li>
            <span class="tp-facts-ico"><Fragment set:html={icon(I.lock)} /></span>
            <span><strong>Bez pomôcok</strong><small>slovníky ani pravidlá nie sú povolené</small></span>
          </li>
        </ul>

        <div class="tp-intro-resume hidden" id="introResumeBox">
          <p id="introResumeText"></p>
          <div class="tp-intro-resume-acts">
            <button class="hp-btn hp-btn-primary hp-btn-sm" type="button" id="resumeSavedBtn">Pokračovať v uloženom teste</button>
            <button class="hp-btn hp-btn-ghost hp-btn-sm" type="button" id="discardSavedBtn">Začať odznova</button>
          </div>
        </div>

        <div class="tp-modes">
          <article class="tp-mode-card is-exam">
            <span class="tp-mode-ico"><Fragment set:html={icon(I.hourglass)} /></span>
            <h3>Ostrý test</h3>
            <p>Ako na skutočnom Testovaní&nbsp;9. Výsledok, správne odpovede a&nbsp;postupy uvidíš až po vyhodnotení.</p>
            <ul class="tp-mode-list">
              <li><Fragment set:html={icon(I.check)} />Odpočítavanie {testItem.durationMinutes} minút</li>
              <li><Fragment set:html={icon(I.check)} />Bez nápovedy a&nbsp;priebežnej kontroly</li>
              <li><Fragment set:html={icon(I.check)} />Poctivý obraz o&nbsp;tom, čo už vieš</li>
            </ul>
            <button class="hp-btn hp-btn-primary" type="button" id="startExamModeBtn">
              Spustiť ostrý test
              <Fragment set:html={icon(I.arrow)} />
            </button>
          </article>

          <article class="tp-mode-card is-practice">
            <span class="tp-mode-ico"><Fragment set:html={icon(I.target)} /></span>
            <h3>Precvičovanie</h3>
            <p>Bez časového tlaku. Každú úlohu si hneď overíš, a&nbsp;keď si nevieš rady, máš po ruke pomoc.</p>
            <ul class="tp-mode-list">
              <li><Fragment set:html={icon(I.check)} />Okamžité overenie odpovede</li>
              <li><Fragment set:html={icon(I.check)} />Nápoveda a&nbsp;postup krok za krokom</li>
              <li><Fragment set:html={icon(I.check)} />Upozornenie na diakritiku a&nbsp;veľké písmená</li>
            </ul>
            <button class="hp-btn tp-btn-teal" type="button" id="startPracticeModeBtn">
              Začať precvičovať
              <Fragment set:html={icon(I.arrow)} />
            </button>
          </article>
        </div>

        <p class="tp-intro-note">
          Pri otvorených úlohách píš odpoveď so správnou diakritikou a&nbsp;veľkými písmenami presne podľa zadania. Na počítači môžeš odpovedať aj klávesmi A&nbsp;–&nbsp;D a&nbsp;prepínať úlohy šípkami.
        </p>
      </section>

      <!-- Výsledkový prehľad po vyhodnotení -->
      <section class="tp-results hidden" id="resultsDashboard" aria-live="polite">
        <div class="tp-archive-note hidden" id="archiveNote">
          <Fragment set:html={icon(I.info)} />
          <p id="archiveNoteText"></p>
          <button class="hp-btn hp-btn-ghost hp-btn-sm hidden" type="button" id="archiveBackBtn">Pokračovať v rozpracovanom teste</button>
        </div>

        <div class="tp-res-hero">
          <div class="tp-ring" id="scoreRing">
            <svg viewBox="0 0 160 160" aria-hidden="true">
              <defs>
                <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" class="tp-ring-stop-a" />
                  <stop offset="100%" class="tp-ring-stop-b" />
                </linearGradient>
              </defs>
              <circle class="tp-ring-bg" cx="80" cy="80" r="68" />
              <circle class="tp-ring-fill" id="scoreRingFill" cx="80" cy="80" r="68" />
            </svg>
            <div class="tp-ring-center">
              <strong id="scorePoints">0/30</strong>
              <span id="scorePercent">0 %</span>
            </div>
          </div>

          <div class="tp-res-info">
            <span class="tp-intro-eyebrow" id="resultsEyebrow">Výsledok testu</span>
            <h2 id="scoreTitle">Výsledok testu</h2>
            <p class="tp-res-lead" id="scoreLead"></p>
            <div class="tp-res-tiles">
              <div class="tp-tile is-ok">
                <span class="tp-tile-ico"><Fragment set:html={icon(I.check)} /></span>
                <span class="tp-tile-txt"><strong id="statCorrectCount">0</strong><small>správne</small></span>
              </div>
              <div class="tp-tile is-err">
                <span class="tp-tile-ico"><Fragment set:html={icon(I.x)} /></span>
                <span class="tp-tile-txt"><strong id="statWrongCount">0</strong><small id="statWrongLabel">nesprávne</small></span>
              </div>
              <div class="tp-tile is-time">
                <span class="tp-tile-ico"><Fragment set:html={icon(I.clock)} /></span>
                <span class="tp-tile-txt"><strong id="statTimeSpent">0 min</strong><small>čas</small></span>
              </div>
            </div>
            <p class="tp-timeup-note hidden" id="timeUpNote">Čas vypršal – test bol vyhodnotený automaticky.</p>
          </div>
        </div>

        <div class="tp-res-actions">
          <button class="hp-btn hp-btn-ghost hp-btn-sm" type="button" id="toggleWrongOnlyBtn">
            <Fragment set:html={icon(I.target)} />
            <span>Prejsť len chybné úlohy</span>
          </button>
          <button class="hp-btn hp-btn-ghost hp-btn-sm" type="button" data-share>
            <Fragment set:html={icon(I.share)} />
            <span data-share-label>Zdieľať test</span>
          </button>
          <button class="hp-btn hp-btn-primary hp-btn-sm" type="button" id="retryTestBtn">
            <Fragment set:html={icon(I.rotate)} />
            <span>Skúsiť test odznova</span>
          </button>
        </div>

        <div class="tp-res-block">
          <div class="tp-res-block-head">
            <h3>Mapa odpovedí</h3>
            <span class="tp-map-legend"><i class="is-ok"></i>správne <i class="is-err"></i>chyba <i class="is-empty"></i>nevyplnená</span>
          </div>
          <div class="tp-map" id="answerMap"></div>
        </div>

        <div class="tp-res-block">
          <div class="tp-res-block-head">
            <h3>Úspešnosť podľa oblastí slovenčiny</h3>
          </div>
          <div class="tp-topics" id="topicsBreakdownGrid"></div>
        </div>

        <div class="print-export-bar">
          <div class="print-name-group">
            <label for="studentNameInput">Meno žiaka pre tlač:</label>
            <input id="studentNameInput" class="student-name-input" type="text" placeholder="Napr. Ján Novák, 9. A" />
          </div>
          <button class="btn-PrintReport" type="button" id="printReportBtn">
            <Fragment set:html={icon(I.printer)} />
            <span>Vytlačiť / uložiť výsledkový list (PDF)</span>
          </button>
        </div>
      </section>

      <!-- Navigátor úloh -->
      <section class="tp-stepper hidden" id="stepperCard" aria-label="Navigácia medzi úlohami">
        <div class="tp-stepper-head">
          <button class="tp-stepper-toggle" type="button" id="stepperToggleBtn" aria-expanded="true">
            <Fragment set:html={icon(I.grid)} />
            <span>Prehľad úloh (01 – {testItem.questionsCount})</span>
            <Fragment set:html={icon(I.chevron)} />
          </button>
          <div class="tp-stepper-legend">
            <span><i class="tp-leg-dot"></i>nevyplnená</span>
            <span><i class="tp-leg-dot is-done"></i>vyplnená</span>
            <span><i class="tp-leg-dot is-ok"></i>správne</span>
            <span><i class="tp-leg-dot is-err"></i>chyba</span>
          </div>
        </div>
        <div class="tp-stepper-grid" id="stepperGrid">
          {activeModule.stepperGroups.map((grp) => (
            <div class="tp-stepper-group">
              <span class="tp-stepper-glabel">{grp.label}:</span>
              {activeModule.questions.slice(grp.fromIndex, grp.toIndex + 1).map((q, localIdx) => {
                const idx = grp.fromIndex + localIdx;
                return (
                  <button
                    class="tp-pill"
                    type="button"
                    data-step-idx={idx}
                    data-qid={q.id}
                    aria-label={`Úloha ${q.code}`}
                  >
                    {q.code}
                  </button>
                );
              })}
            </div>
          ))}
        </div>
      </section>

      <!-- Filter chybných úloh -->
      <div class="tp-wrong-banner hidden" id="wrongModeBanner">
        <span>Zobrazujú sa len chybne zodpovedané alebo nevyplnené úlohy.</span>
        <button class="hp-btn hp-btn-ghost hp-btn-sm" type="button" id="exitWrongModeBtn">Zobraziť všetky úlohy</button>
      </div>

      <!-- Pracovný priestor: ukážka vľavo + karta úlohy vpravo -->
      <section class="tp-workspace hidden" id="workspace">
        <div class="tp-ctx-col hidden" id="sharedContextContainer">
          <div class="tp-ctx" id="sharedContextCard">
            <button class="tp-ctx-toggle" type="button" id="ctxToggleBtn" aria-expanded="true">
              <span id="ctxToggleLabel">Ukážka k úlohe</span>
              <span class="tp-ctx-chv"><Fragment set:html={icon(I.chevron)} /></span>
            </button>
            <div class="tp-ctx-body" id="sharedContextBody"></div>
          </div>
        </div>

        <article class="tp-qcard" id="questionCard">
          <div class="tp-qhead">
            <div class="tp-qbadges">
              <span class="tp-qnum" id="qNumberBadge">Úloha 01</span>
              <span class="tp-qcat" id="qCategoryBadge">Téma</span>
              <span class="tp-qtype" id="qTypeBadge">Výber odpovede</span>
            </div>
            <div class="tp-qactions">
              <button class="tp-flag-btn" type="button" id="flagQuestionBtn" title="Označiť úlohu na neskoršiu kontrolu">
                <Fragment set:html={icon(I.flag)} />
                <span id="flagQuestionBtnText">Označiť</span>
              </button>
              <button class="tp-report-btn" type="button" id="reportQuestionBtn" title="Nahlásiť chybu v zadaní">
                <Fragment set:html={icon(I.alert)} />
                <span>Chyba</span>
              </button>
            </div>
          </div>

          <div class="tp-qtext" id="questionText"></div>
          <div id="questionDiagramContainer"></div>
          <div class="tp-qtext hidden" id="questionTextAfter"></div>

          <div id="answerSection"></div>

          <div class="tp-action-strip" id="questionHelpStrip">
            <button class="hp-btn hp-btn-primary hp-btn-sm hidden" type="button" id="checkSingleBtn">
              <Fragment set:html={icon(I.check)} />
              <span>Overiť odpoveď</span>
            </button>

            <div class="tp-help-btns">
              <button class="hp-btn hp-btn-ghost hp-btn-sm tp-btn-hint" type="button" id="openHintBtn">
                <Fragment set:html={icon(I.bulb)} />
                <span>Nápoveda</span>
              </button>
              <button class="hp-btn hp-btn-ghost hp-btn-sm tp-btn-sol" type="button" id="openSolutionBtn">
                <Fragment set:html={icon(I.book)} />
                <span>Postup riešenia</span>
              </button>
            </div>
          </div>

          <div class="tp-feedback hidden" id="evalFeedbackBanner">
            <span id="evalFeedbackIcon"></span>
            <div class="tp-feedback-text" id="evalFeedbackInfo"></div>
            <button class="hp-btn hp-btn-ghost hp-btn-sm hidden" type="button" id="evalOpenSolutionBtn">Pozrieť postup</button>
          </div>

          <div class="tp-qfoot">
            <button class="hp-btn hp-btn-ghost hp-btn-sm" type="button" id="prevQuestionBtn">
              <Fragment set:html={icon(I.arrowLeft)} />
              <span>Predošlá</span>
            </button>
            <span class="tp-pos" id="footerPositionText">1 / {testItem.questionsCount}</span>
            <button class="hp-btn hp-btn-primary hp-btn-sm" type="button" id="nextQuestionBtn">
              <span id="nextBtnText">Ďalšia úloha</span>
              <span id="nextBtnArrow"><Fragment set:html={icon(I.arrow)} /></span>
            </button>
          </div>
        </article>
      </section>

      <!-- Výtlačok výsledkového listu -->
      <section class="printable-report" id="printableReport" aria-hidden="true"></section>
    </main>

    <SiteFooter test={testItem} />

    <!-- Modal Nápoveda -->
    <div class="modal-backdrop hidden" id="hintModal" role="dialog" aria-modal="true" aria-labelledby="hintModalTitle">
      <div class="modal-window">
        <div class="modal-header hint-header">
          <div class="modal-title-group">
            <Fragment set:html={icon(I.bulb)} />
            <div>
              <span class="modal-eyebrow">Nápoveda k úlohe</span>
              <h3 id="hintModalTitle">Úloha</h3>
            </div>
          </div>
          <button class="modal-close-btn" type="button" data-close-modal="hintModal" aria-label="Zavrieť nápovedu">
            <Fragment set:html={icon(I.x)} />
          </button>
        </div>
        <div class="modal-body">
          <div class="tp-hint-box" id="hintModalContent"></div>
          <p class="tp-modal-note">Nápoveda nie je autorským dielom NIVaM a&nbsp;NIVaM nezodpovedá za&nbsp;jej obsah.</p>
        </div>
        <div class="modal-footer">
          <button class="hp-btn hp-btn-ghost hp-btn-sm" type="button" data-report="hint">Nahlásiť chybu v nápovede</button>
          <div class="modal-footer-right">
            <button class="hp-btn hp-btn-ghost hp-btn-sm tp-btn-sol" type="button" id="switchHintToSolutionBtn">
              <Fragment set:html={icon(I.book)} />
              <span>Zobraziť postup riešenia</span>
            </button>
            <button class="hp-btn hp-btn-primary hp-btn-sm" type="button" data-close-modal="hintModal">Zavrieť</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal Postup riešenia -->
    <div class="modal-backdrop hidden" id="solutionModal" role="dialog" aria-modal="true" aria-labelledby="solutionModalTitle">
      <div class="modal-window modal-large">
        <div class="modal-header solution-header">
          <div class="modal-title-group">
            <Fragment set:html={icon(I.book)} />
            <div>
              <span class="modal-eyebrow">Postup riešenia krok za krokom</span>
              <h3 id="solutionModalTitle">Úloha</h3>
            </div>
          </div>
          <button class="modal-close-btn" type="button" data-close-modal="solutionModal" aria-label="Zavrieť postup riešenia">
            <Fragment set:html={icon(I.x)} />
          </button>
        </div>
        <div class="modal-body">
