      // Čitateľnejšie písmo (Atkinson Hyperlegible Next) je v teste vždy zapnuté (trieda tp-dyslexic na <body>).
      // Prepínače veľkosti písma, kontrastu a písma boli zrušené – staré uložené nastavenia sa mažú.
      safeStorageRemove(A11Y_KEY);

      // Ukladanie a obnova stavu
      function saveStateToStorage() {
        // Pri prezeraní archivovaného výsledku sa nesmie prepísať rozpracovaný nový pokus
        if (!mode || viewingArchive) return;
        try {
          safeStorageSet(
            STORAGE_KEY,
            JSON.stringify({
              mode,
              currentIndex,
              userAnswers,
              singleCheckedState,
              flaggedQuestions,
              isEvaluated,
              filterWrongOnly,
              studentName,
              remainingSeconds,
              elapsedSeconds,
              savedAt: Date.now()
            })
          );
        } catch (e) {}
